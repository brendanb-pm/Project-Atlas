function getAtlasAuthenticationConfig_(){var p=PropertiesService.getScriptProperties(),raw=p.getProperty('ATLAS_AUTH_CONFIG'),value={};if(raw){try{value=JSON.parse(raw);}catch(error){throw new VmosConfigurationError_('Atlas authentication configuration is unavailable.');}}var session=value.session||{},gateway=String(value.verificationGatewayUrl||''),redirect=String(value.redirectUri||'');if(gateway&&!/^https:\/\//i.test(gateway))throw new VmosConfigurationError_('Atlas authentication verification gateway must use HTTPS.');if(redirect&&!/^https:\/\//i.test(redirect))throw new VmosConfigurationError_('Atlas authentication redirect must use HTTPS.');return Object.freeze({providers:Object.freeze({MICROSOFT:atlasOidcProviderConfig_('MICROSOFT',value.microsoft||{}),GOOGLE:atlasOidcProviderConfig_('GOOGLE',value.google||{})}),verificationGatewayUrl:gateway,redirectUri:redirect,session:Object.freeze({lifetimeSeconds:atlasAuthBound_(session.lifetimeSeconds,3600,300,43200),recentAuthSeconds:atlasAuthBound_(session.recentAuthSeconds,900,60,3600)}),allowedReturnRoutes:Object.freeze((value.allowedReturnRoutes||['home']).map(function(x){return String(x).toLowerCase();}))});}
function atlasOidcProviderConfig_(name,input){var issuers=(input.issuers||[]).map(String);if(name==='GOOGLE'&&!issuers.length)issuers=['https://accounts.google.com','accounts.google.com'];var endpoint=String(input.authorizationEndpoint||(name==='GOOGLE'?'https://accounts.google.com/o/oauth2/v2/auth':'https://login.microsoftonline.com/common/oauth2/v2.0/authorize'));if(!/^https:\/\//i.test(endpoint))throw new VmosConfigurationError_('Atlas authentication provider endpoint must use HTTPS.');return Object.freeze({provider:name,enabled:input.enabled===true,clientId:String(input.clientId||''),authorizationEndpoint:endpoint,issuers:Object.freeze(issuers),allowedDomains:Object.freeze((input.allowedDomains||[]).map(function(x){return String(x).trim().toLowerCase();}).filter(Boolean)),allowPersonalAccounts:input.allowPersonalAccounts===true,scopes:Object.freeze((input.scopes||['openid','profile','email']).map(String))});}
function atlasAuthBound_(value,fallback,min,max){value=Number(value||fallback);if(!isFinite(value)||value<min||value>max)throw new VmosConfigurationError_('Atlas authentication session policy is invalid.');return Math.floor(value);}
