function PurchasingWorkspaceService_(dependencies){dependencies=dependencies||{};this.purchases=dependencies.purchases||new PurchaseApprovalService_();this.limit=Math.min(100,Math.max(1,Number(dependencies.limit||50)));}
PurchasingWorkspaceService_.prototype.assertTenant_=function(row,context){if(!row)throw new VmosNotFoundError_('Purchase request was not found.');if(row.securityTenantId&&String(row.securityTenantId)!==String(context.tenantId))throw new VmosAuthorizationError_('Purchase request is unavailable.');return row;};
PurchasingWorkspaceService_.prototype.project_=function(row){return {id:row.id,requestDate:row.requestDate,requester:row.requester,vendor:row.vendor,category:row.category,classification:row.classification,businessJustification:row.businessJustification,expectedRoiNeed:row.expectedRoiNeed,description:row.description,amount:row.amount,actualPurchaseAmount:row.actualPurchaseAmount,status:row.status,approvalRequired:row.approvalRequired,approver:row.approver,approvedAt:row.approvedAt,receiptReference:row.receiptReference,notes:row.notes};};
PurchasingWorkspaceService_.prototype.get=function(request,context){request=request||{};var self=this,query=String(request.query||'').toLowerCase(),all=this.purchases.list().filter(function(row){return !row.securityTenantId||String(row.securityTenantId)===String(context.tenantId);}),matches=all.filter(function(row){return !query||String(row.vendor+' '+row.description+' '+row.status+' '+row.category).toLowerCase().indexOf(query)!==-1;}),selected=request.id?this.assertTenant_(this.purchases.get(request.id),context):null,caps=context.capabilities||[];return serializeVmosValue_({items:matches.slice(0,this.limit).map(function(row){return self.project_(row);}),selected:selected?this.project_(selected):null,totalMatching:matches.length,truncated:matches.length>this.limit,actions:{request:caps.indexOf('PURCHASE_REQUEST')!==-1,approve:caps.indexOf('PURCHASE_APPROVE')!==-1,recordReceipt:caps.indexOf('PURCHASE_REQUEST')!==-1},policy:{rejectionSupported:false,thresholdConfigured:true},bound:this.limit});};
