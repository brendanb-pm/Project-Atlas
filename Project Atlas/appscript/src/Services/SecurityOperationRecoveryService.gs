function SecurityOperationRecoveryService_(dependencies){dependencies=dependencies||{};this.securityEvents=dependencies.securityEvents||new SecurityAuditEventRepository_();this.followUps=dependencies.followUps||new FollowUpRepository_();this.followUpEvents=dependencies.followUpEvents||new FollowUpEventRepository_();this.jobs=dependencies.jobs||new MvpService_('Job');this.jobEvents=dependencies.jobEvents||new JobEventRepository_();this.ledger=dependencies.ledger||new SecurityAuditService_({repository:this.securityEvents});this.clock=dependencies.clock||function(){return new Date();};}
SecurityOperationRecoveryService_.prototype.recover=function(eventId){var record=this.securityEvents.get(eventId);if(!record||String(record.status).toUpperCase()!=='RECOVERY_REQUIRED')return record;try{var result;if(record.recoveryType==='FOLLOW_UP_DOMAIN_EVENT')result=this.recoverFollowUpEvent_(record);else if(record.recoveryType==='SHOP_FLOOR_DOMAIN_EVENT')result=this.recoverShopFloorEvent_(record);else throw new VmosConfigurationError_('No recovery handler is registered for this operation.');return this.ledger.markRecovered(record,result);}catch(error){this.ledger.markRecoveryFailed(record,error);throw error;}};
SecurityOperationRecoveryService_.prototype.recoverFollowUpEvent_=function(record){if(!record.resourceId)throw new VmosConfigurationError_('Recovery resource is unavailable.');var existing=this.followUpEvents.findByCorrelation(record.resourceId,record.correlationId);if(existing)return this.followUps.get(record.resourceId);var followUp=this.followUps.get(record.resourceId),context={};try{context=JSON.parse(record.recoveryJson||'{}');}catch(ignored){}var eventType=context.eventType||this.eventTypeFor_(record.operation),previous=Number(context.expectedVersion||Math.max(0,Number(followUp.version||1)-1));this.followUpEvents.append({id:'FUE-RECOVERY-'+record.id,followUpId:followUp.id,eventType:eventType,occurredAt:this.clock(),actor:record.userId,correlationId:record.correlationId,previousVersion:previous,newVersion:Number(followUp.version||previous+1),details:JSON.stringify({recoveredFromSecurityOperation:record.id,context:context})});return followUp;};
SecurityOperationRecoveryService_.prototype.eventTypeFor_=function(operation){return {completeFollowUp:'COMPLETED',cancelFollowUp:'CANCELLED',scheduleFollowUp:'SCHEDULED',rescheduleFollowUp:'RESCHEDULED',reassignFollowUp:'REASSIGNED'}[operation]||'';};
SecurityOperationRecoveryService_.prototype.recoverShopFloorEvent_=function(record){if(!record.resourceId)throw new VmosConfigurationError_('Recovery resource is unavailable.');var context={};try{context=JSON.parse(record.recoveryJson||'{}');}catch(ignored){}var commandId=context.commandId||record.idempotencyKey,existing=this.jobEvents.listByJobId(record.resourceId).filter(function(event){return String(event.commandId)===String(commandId);})[0];if(existing)return this.jobs.get(record.resourceId);var job=this.jobs.get(record.resourceId);this.jobEvents.append({id:'EVT-RECOVERY-'+record.id,jobId:job.id,eventType:context.eventType||'RECOVERED_OPERATION',occurredAt:this.clock(),actor:record.userId,previousStatus:'',newStatus:job.status||context.targetStatus||'',notes:'Recovered append-only audit event.',workflowId:'',workflowVersion:'1',commandId:commandId});return job;};
