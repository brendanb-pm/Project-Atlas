/** Safe tenant-admin presentation; never returns raw configuration or credential references. */
function AdminWorkspaceService_(dependencies){dependencies=dependencies||{};this.profile=dependencies.profile||getAtlasDeploymentProfile_;this.health=dependencies.health||new AtlasActivationHealthService_();this.calendar=dependencies.calendar||getCalendarFollowUpConfig_;}
AdminWorkspaceService_.prototype.get=function(context){var profile=this.profile(),health=this.health.get(context),calendar;try{calendar=this.calendar();}catch(ignored){calendar=null;}return serializeVmosValue_({tenant:{productDisplayName:profile.productDisplayName,organizationName:profile.organizationName||'Not configured',deploymentDisplayName:profile.deploymentDisplayName||'Default deployment',terminology:profile.terminology},modules:{enabled:profile.enabledModules,optional:true},integrations:{calendar:!calendar?'ATTENTION_REQUIRED':calendar.enabled?(calendar.provider&&calendar.calendarId?'CONFIGURED':'ATTENTION_REQUIRED'):'DISABLED'},systemHealth:{followUps:adminHealthLabel_(health.sources.followUps,'Follow-Up storage'),purchasing:adminHealthLabel_(health.sources.purchasing,'Purchasing'),calendarReview:adminHealthLabel_(health.sources.calendarReview,'Calendar review')},identityAdministrationAvailable:(context.capabilities||[]).indexOf('ADMIN_IDENTITY')!==-1});};
function AdminIdentityWorkspaceService_(dependencies){dependencies=dependencies||{};this.users=dependencies.users||new AtlasUserRepository_();this.memberships=dependencies.memberships||new TenantMembershipRepository_();this.identities=dependencies.identities||new ExternalIdentityReferenceRepository_();this.limit=Math.min(200,Math.max(1,Number(dependencies.limit||100)));}
AdminIdentityWorkspaceService_.prototype.get=function(context){var tenantId=context.tenantId,users=this.users.list(),memberships=this.memberships.list().filter(function(item){return String(item.tenantId)===String(tenantId);}),linked={};this.identities.list().forEach(function(item){if(item.status==='ACTIVE')linked[item.userId]=true;});var byId=users.reduce(function(index,user){index[user.id]=user;return index;},{}),total=memberships.length;return serializeVmosValue_({items:memberships.slice(0,this.limit).map(function(item){var user=byId[item.userId]||{};return {userId:item.userId,displayName:user.displayName||'User',userStatus:user.status||'UNKNOWN',membershipStatus:item.status||'UNKNOWN',roles:parseIdentityList_(item.roles),capabilityCount:parseIdentityList_(item.capabilities).length,externalIdentityLinked:!!linked[item.userId]};}),resultCount:Math.min(total,this.limit),totalMatching:total,truncated:total>this.limit});};
function adminHealthLabel_(state,label){var map={READY:'Ready',EMPTY:'Ready — no records',DISABLED:'Disabled',NOT_CONFIGURED:'Setup required',SOURCE_UNAVAILABLE:'Setup or attention required',NOT_AUTHORIZED:'Not available for your access'};return {label:label,state:state,message:map[state]||'Attention required'};}
