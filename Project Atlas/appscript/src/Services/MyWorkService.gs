MyWorkService_.prototype.filters_=function(items){var values=['All'];['Due','Blocked','Follow-Ups','Production','Approvals'].forEach(function(filter){if(items.some(function(item){return filter==='Due'?['OVERDUE','DUE_TODAY','DUE_TOMORROW','THIS_WEEK'].indexOf(item.urgency)!==-1:filter==='Blocked'?item.urgency==='BLOCKED':item.filter===filter;}))values.push(filter);});return values;};
