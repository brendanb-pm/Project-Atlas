MyWorkService_.prototype.get=function(context){context=context||{};var self=this,caps=context.capabilities||[],tenant=String(context.tenantId||''),actor=String(context.userId||''),items=[],unavailable=[],sources=[],failedSources=[],overflow={};if(!actor||!tenant)throw new VmosAuthorizationError_('Authenticated Atlas work context is unavailable.');
