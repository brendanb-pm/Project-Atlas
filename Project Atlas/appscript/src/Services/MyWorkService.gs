MyWorkService_.prototype.urgency_=function(due,blocked,waiting){if(!due)return blocked?'BLOCKED':waiting?'WAITING_ON_ME':'ASSIGNED';var today=new Date(this.clock());today.setHours(0,0,0,0);var target=new Date(due);target.setHours(0,0,0,0);var days=Math.round((target-today)/86400000);if(days<0)return 'OVERDUE';if(blocked)return 'BLOCKED';if(days===0)return 'DUE_TODAY';if(waiting)return 'WAITING_ON_ME';if(days===1)return 'DUE_TOMORROW';if(days<=7)return 'THIS_WEEK';return 'ASSIGNED';};
