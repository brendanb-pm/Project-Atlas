PlatformCommercialWorkspaceService_.prototype.get=function(context,query,limit){assertPlatformCommercialContext_(context,'PLATFORM_TENANT_READ');var tenants=this.tenants.search(query,limit),self=this;return {scope:'PLATFORM',resultCount:tenants.length,truncated:tenants.length>=Math.min(200,Math.max(1,Number(limit||50))),items:tenants.map(function(tenant){var subscription=self.subscriptions.findForTenant(tenant.id).sort(function(a,b){return String(b.updatedAt).localeCompare(String(a.updatedAt));})[0]||{},plan=self.plans.get(subscription.planVersionId)||{},seat=self.seats.summary(tenant.id),modules=self.entitlements.listForTenant(tenant.id).filter(function(item){return item.type==='MODULE'&&item.state==='ACTIVE';}).map(function(item){return item.key;}),attention=[];if(['PAYMENT_FAILED','PAST_DUE','GRACE','SUSPENDED'].indexOf(subscription.state)!==-1)attention.push(subscription.state);if(seat.overage)attention.push('OVER_ENTITLEMENT');return {tenantId:tenant.id,tenantName:tenant.displayName,commercialState:tenant.commercialState,subscriptionState:subscription.state||'NOT_CONFIGURED',plan:plan.planKey||subscription.planVersionId||'Not configured',purchasedSeats:seat.purchased,seatsInUse:seat.assigned,seatsAvailable:seat.available,seatOverage:seat.overage,planSeatCap:seat.planSeatCap,modules:modules,billingFrequency:subscription.billingFrequency||'',nextBillingAt:subscription.nextBillingAt||'',billingAnchorDay:subscription.billingAnchorDay||'',paymentStatus:subscription.paymentStatus||'',paymentMethodCategory:subscription.paymentMethodCategory||'',trialEndsAt:subscription.trialEndsAt||'',attention:attention,recentChanges:self.audit.recentForTenant(tenant.id,5)};})};};
