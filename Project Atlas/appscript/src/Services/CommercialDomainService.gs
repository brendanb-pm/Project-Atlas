function assertPlatformCommercialContext_(context,capability){if(!context||context.authoritative!==true||(context.capabilities||[]).indexOf(capability)===-1)throw new VmosAuthorizationError_('Platform commercial authorization is required.');return context;}
function assertTenantCommercialContext_(context,tenantId,capability){if(!context||context.authoritative!==true||String(context.tenantId)!==String(tenantId)||(context.capabilities||[]).indexOf(capability)===-1)throw new VmosAuthorizationError_('Tenant administration authorization is required.');return context;}
function SeatMeteringService_(dependencies){dependencies=dependencies||{};this.memberships=dependencies.memberships||new TenantMembershipRepository_();this.users=dependencies.users||new AtlasUserRepository_();this.assignments=dependencies.assignments||new AtlasSeatAssignmentRepository_();this.subscriptions=dependencies.subscriptions||new AtlasSubscriptionRepository_();this.plans=dependencies.plans||new AtlasPlanVersionRepository_();}
SeatMeteringService_.prototype.summary=function(tenantId){var users=this.users.list().reduce(function(index,user){index[user.id]=user;return index;},{}),memberships=this.memberships.list().filter(function(item){return String(item.tenantId)===String(tenantId)&&String(item.status).toUpperCase()==='ACTIVE';}),eligible={};memberships.forEach(function(item){var user=users[item.userId]||{},kind=String(user.identityType||user.userType||'HUMAN').toUpperCase();if(String(user.status).toUpperCase()==='ACTIVE'&&['SYSTEM','SERVICE','PROVIDER','KIOSK'].indexOf(kind)===-1)eligible[item.userId]=true;});var assigned=this.assignments.listForTenant(tenantId).filter(function(item){return String(item.state).toUpperCase()==='ACTIVE'&&eligible[item.userId];}),subscription=this.subscriptions.findForTenant(tenantId).filter(function(item){return ['TRIAL','ACTIVE','PAYMENT_PENDING','PAYMENT_FAILED','PAST_DUE','GRACE'].indexOf(String(item.state).toUpperCase())!==-1;})[0]||{},plan=this.plans.get?this.plans.get(subscription.planVersionId):null,purchased=Math.max(0,Number(subscription.purchasedSeats||0)),cap=plan&&Number(plan.selfServiceSeatCap||0)||0;return {tenantId:tenantId,policy:'PURCHASED_ACTIVE_HUMAN_ASSIGNMENTS',purchased:purchased,planSeatCap:cap,assigned:assigned.length,billable:assigned.length,available:Math.max(0,purchased-assigned.length),overage:Math.max(0,assigned.length-purchased),occupants:assigned.map(function(item){return {userId:item.userId,assignedAt:item.assignedAt};})};};
function CommercialEntitlementService_(dependencies){dependencies=dependencies||{};this.subscriptions=dependencies.subscriptions||new AtlasSubscriptionRepository_();this.entitlements=dependencies.entitlements||new AtlasEntitlementRepository_();}
CommercialEntitlementService_.prototype.decision=function(request){var tenantId=request.tenantId,subscriptions=this.subscriptions.findForTenant(tenantId).filter(function(item){return ['TRIAL','ACTIVE','PAYMENT_PENDING','PAYMENT_FAILED','PAST_DUE','GRACE'].indexOf(item.state)!==-1;}),grants=this.entitlements.listForTenant(tenantId).filter(function(item){return item.state==='ACTIVE';}),key=request.entitlementKey||'ATLAS_CORE',grant=grants.filter(function(item){return item.key===key;})[0];if(!subscriptions.length)return {allowed:false,reason:'SUBSCRIPTION_UNAVAILABLE'};if(!grant)return {allowed:false,reason:'ENTITLEMENT_UNAVAILABLE'};return {allowed:true,reason:'ENTITLED',subscriptionId:subscriptions[0].id,entitlementId:grant.id};}; CommercialEntitlementService_.prototype.assertAllowed=function(request){var decision=this.decision(request);if(!decision.allowed)throw new VmosAuthorizationError_('Commercial entitlement is unavailable.');return decision;};
function CommercialDomainService_(dependencies){dependencies=dependencies||{};this.tenants=dependencies.tenants||new AtlasTenantRepository_();this.plans=dependencies.plans||new AtlasPlanVersionRepository_();this.subscriptions=dependencies.subscriptions||new AtlasSubscriptionRepository_();this.entitlements=dependencies.entitlements||new AtlasEntitlementRepository_();this.audit=dependencies.audit||new AtlasCommercialAuditRepository_();this.clock=dependencies.clock||function(){return new Date();};this.uuid=dependencies.uuid||function(){return Utilities.getUuid().toUpperCase();};}
CommercialDomainService_.prototype.createTenant=function(input,context,commandId){assertPlatformCommercialContext_(context,'PLATFORM_TENANT_MANAGE');if(!commandId)throw new VmosValidationError_('Commercial command ID is required.');if(!input||!input.id||!input.displayName)throw new VmosValidationError_('Preallocated Tenant ID and display name are required.');var prior=this.audit.findByCommand(input.id,commandId);if(prior)return this.tenants.get(prior.resourceId);var now=this.clock(),record={id:input.id,displayName:String(input.displayName).trim(),status:'ACTIVE',commercialState:'TRIAL',billingOrganizationReference:input.billingOrganizationReference||'',billingContactJson:'',billingAddressJson:'',createdAt:now,updatedAt:now};this.tenants.create(record);this.audit.create({id:'CAE-'+this.uuid(),tenantId:record.id,eventType:'TENANT_CREATED',resourceType:'Tenant',resourceId:record.id,actorType:context.actorType||'USER',actorId:context.userId,correlationId:context.correlationId,commandId:commandId,previousJson:'',proposedJson:JSON.stringify({status:record.status,commercialState:record.commercialState}),reason:input.reason||'',occurredAt:now,outcome:'SUCCEEDED'});return record;};
