function CalendarWorkspaceReadService_(dependencies){dependencies=dependencies||{};this.connections=dependencies.connections;this.links=dependencies.links;this.requests=dependencies.requests;this.followUps=dependencies.followUps;this.customers=dependencies.customers;this.users=dependencies.users||(typeof AtlasUserRepository_!=='undefined'?new AtlasUserRepository_():{list:function(){return [];}});this.memberships=dependencies.memberships||(typeof TenantMembershipRepository_!=='undefined'?new TenantMembershipRepository_():{list:function(){return [];}});this.registry=dependencies.registry||new CalendarProviderRegistry_();this.calendarConfig=dependencies.calendarConfig||getCalendarFollowUpConfig_;}
