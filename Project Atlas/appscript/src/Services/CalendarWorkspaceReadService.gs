function CalendarWorkspaceReadService(dependencies){dependencies=dependencies||{};this.connections=dependencies.connections||new UserCalendarConnectionRepository();this.links=dependencies.links||new CalendarFollowUpLinkRepository();this.requests=dependencies.requests||new ExternalChangeRequestRepository();this.followUps=dependencies.followUps||new FollowUpRepository();this.customers=dependencies.customers||new MvpService('Customer');this.registry=dependencies.registry||new CalendarProviderRegistry();}
CalendarWorkspaceReadService.prototype.get=function(userId){var configured=getConfiguredCalendarProviderKeys_(),providers=this.registry.list().map(function(provider){provider.authorizationConfigured=configured.indexOf(provider.providerKey)!==-1;return provider;});return {actor:userId,calendarIntegrationEnabled:getCalendarFollowUpConfig_().enabled,connections:this.connections.listByUserId(userId).map(this.connectionView_),links:this.links.list().map(this.linkView_),requests:this.requests.list().filter(function(r){return r.status==='PENDING_REVIEW';}).map(this.requestView_),followUps:this.followUps.list(),customers:this.customers.list(),providers:providers};};
CalendarWorkspaceReadService.prototype.connectionView_=function(c){return {id:c.id,userId:c.userId,provider:c.provider,externalAccountDisplayName:c.externalAccountDisplayName,externalCalendarDisplayName:c.externalCalendarDisplayName,connectionStatus:c.connectionStatus,tokenExpiresAt:c.tokenExpiresAt,lastSyncAt:c.lastSyncAt,lastSuccessfulSyncAt:c.lastSuccessfulSyncAt,lastError:c.lastError};};
CalendarWorkspaceReadService.prototype.linkView_=function(l){return {followUpId:l.followUpId,connectionId:l.connectionId,provider:l.provider,hasExternalProjection:!!l.externalEventId,lastSyncAt:l.lastSyncAt};};
CalendarWorkspaceReadService.prototype.requestView_=function(r){return {id:r.id,followUpId:r.followUpId,provider:r.provider,changeType:r.changeType,status:r.status,requestedStartAt:r.requestedStartAt,requestedEndAt:r.requestedEndAt,requestedTimeZone:r.requestedTimeZone,previousStartAt:r.previousStartAt,previousEndAt:r.previousEndAt,previousTimeZone:r.previousTimeZone,detectedAt:r.detectedAt,message:r.changeType==='CLEANUP_FAILED'?'Your MOS change was saved, but the previous calendar event could not be removed.':''};};
