/** Tenant-only identity administration. PLATFORM_* authority is never assignable here. */
function TenantOperationalAdminService_(dependencies){dependencies=dependencies||{};this.users=dependencies.users||new AtlasUserRepository_();this.memberships=dependencies.memberships||new TenantMembershipRepository_();this.invitations=dependencies.invitations||new AtlasTenantInvitationRepository_();this.clock=dependencies.clock||function(){return new Date();};this.uuid=dependencies.uuid||function(){return Utilities.getUuid().toUpperCase();};}
TenantOperationalAdminService_.prototype.roles_=function(values){var roles=parseIdentityList_(values),allowed=Object.keys(ATLAS_DEFAULT_ROLE_CAPABILITIES);if(!roles.length)throw new VmosValidationError_('At least one approved tenant role is required.');roles.forEach(function(role){if(allowed.indexOf(role)===-1||role.indexOf('PLATFORM_')===0)throw new VmosAuthorizationError_('Only approved tenant roles may be assigned.');});return roles;};
TenantOperationalAdminService_.prototype.workspace=function(context){var tenantId=context.tenantId,users=this.users.list(),memberships=this.memberships.list().filter(function(row){return String(row.tenantId)===String(tenantId);}),invitations=[],invitationState='READY',index={};try{invitations=this.invitations.listForTenant(tenantId,50);}catch(ignored){invitationState='NOT_CONFIGURED';}users.forEach(function(user){index[user.id]=user;});return serializeVmosValue_({memberships:memberships.slice(0,100).map(function(row){var user=index[row.userId]||{};return {membershipId:row.id,userId:row.userId,displayName:user.displayName||'User',userStatus:user.status||'UNKNOWN',status:row.status||'UNKNOWN',roles:parseIdentityList_(row.roles)};}),invitations:invitations.map(function(row){return {id:row.id,emailReference:row.emailReference,status:row.status,roles:parseIdentityList_(row.roleKeysJson),invitedAt:row.invitedAt,expiresAt:row.expiresAt};}),invitationState:invitationState,approvedRoles:Object.keys(ATLAS_DEFAULT_ROLE_CAPABILITIES).filter(function(role){return role.indexOf('PLATFORM_')!==0;}),bounds:{memberships:100,invitations:50}});};
TenantOperationalAdminService_.prototype.invite=function(input,context,resourceId){input=input||{};var email=String(input.email||'').trim().toLowerCase();if(!/^\S+@\S+\.\S+$/.test(email))throw new VmosValidationError_('A valid email is required.');var roles=this.roles_(input.roles),existing=this.invitations.listForTenant(context.tenantId,200).filter(function(row){return String(row.emailReference).toLowerCase()===email&&String(row.status).toUpperCase()==='PENDING';})[0];if(existing)return existing;var now=this.clock();return this.invitations.create({id:resourceId||'INVITE-'+this.uuid(),tenantId:context.tenantId,emailReference:email,roleKeysJson:JSON.stringify(roles),status:'PENDING',invitedBy:context.userId,invitedAt:now,expiresAt:'',acceptedByUserId:'',acceptedAt:'',cancelledAt:'',updatedAt:now});};
TenantOperationalAdminService_.prototype.updateMembership=function(membershipId,input,context){input=input||{};var row=this.memberships.get(membershipId);if(!row||String(row.tenantId)!==String(context.tenantId))throw new VmosAuthorizationError_('Membership is unavailable.');var changes={updatedAt:this.clock()};if(input.roles!==undefined)changes.roles=JSON.stringify(this.roles_(input.roles));if(input.status!==undefined){var status=String(input.status).toUpperCase();if(['ACTIVE','INACTIVE'].indexOf(status)===-1)throw new VmosValidationError_('Membership status is invalid.');if(String(row.userId)===String(context.userId)&&status==='INACTIVE')throw new VmosValidationError_('You cannot deactivate your own active membership.');changes.status=status;}return this.memberships.update(membershipId,changes);};
