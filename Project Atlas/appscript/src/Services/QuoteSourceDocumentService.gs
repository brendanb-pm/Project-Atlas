QuoteSourceDocumentService_.prototype.tenantRow_=function(row,context,label){if(!row||String(row.securityTenantId||row.tenantId)!==String(context.tenantId))throw new VmosAuthorizationError_((label||'Related record')+' is unavailable.');return row;};
QuoteSourceDocumentService_.prototype.withLock_=function(work){if(this.lock)this.lock.waitLock(30000);try{return work();}finally{if(this.lock)this.lock.releaseLock();}};
QuoteSourceDocumentService_.prototype.targetId_=function(input,type){return String({QUOTE:input.quoteId,RFQ:input.rfqId,CUSTOMER:input.customerId,PART:input.partId,VENDOR:input.vendorId,QUOTE_COST_LINE:input.costLineId,SOURCE_DOCUMENT:input.documentId,JOB:input.jobId}[type]||'');};
QuoteSourceDocumentService_.prototype.validate_=function(input,context){input=input||{};var type=String(input.relationshipType||'QUOTE').toUpperCase(),purpose=String(input.purpose||'OTHER').toUpperCase(),visibility=String(input.visibility||'INTERNAL').toUpperCase();if(ATLAS_QUOTE_SOURCE_RELATIONSHIPS.indexOf(type)===-1)throw new VmosValidationError_('Relationship type is invalid.');if(ATLAS_QUOTE_SOURCE_PURPOSES.indexOf(purpose)===-1)throw new VmosValidationError_('Document purpose is invalid.');if(['INTERNAL','CUSTOMER_APPROVED'].indexOf(visibility)===-1)throw new VmosValidationError_('Document visibility is invalid.');var quote=this.tenantRow_(this.quotes.get(input.quoteId),context,'Quote'),document=this.tenantRow_(this.documents.get(input.documentId),context,'Source document');if(visibility==='CUSTOMER_APPROVED'&&document.customerEligible!==true&&String(document.customerEligible).toUpperCase()!=='TRUE')throw new VmosAuthorizationError_('This source document is internal and cannot be customer-visible.');if(visibility==='CUSTOMER_APPROVED'&&(context.capabilities||[]).indexOf('QUOTE_WRITE')===-1)throw new VmosAuthorizationError_('Customer document visibility is unavailable.');
  if(input.customerId){var customer=this.tenantRow_(this.customers.get(input.customerId),context,'Customer');if(String(quote.customerId)!==String(customer.id))throw new VmosValidationError_('Customer does not belong to this Quote.');}
