  if(input.estimateId){var estimate=this.tenantRow_(this.estimates.get(input.estimateId),context,'Cost estimate');if(String(estimate.quoteId)!==String(quote.id))throw new VmosValidationError_('Cost estimate does not belong to this Quote.');}
  if(input.costLineId){var line=this.tenantRow_(this.costLines.get(input.costLineId),context,'Cost line'),parent=this.tenantRow_(this.estimates.get(line.estimateId),context,'Cost estimate');if(String(parent.quoteId)!==String(quote.id))throw new VmosValidationError_('Cost line does not belong to this Quote.');if(input.partId&&String(line.partId)!==String(input.partId))throw new VmosValidationError_('Part does not belong to the selected cost line.');}
  if(input.quoteRevisionId){if(!this.revisions)throw new VmosConfigurationError_('Quote revision relationships are unavailable.');var revision=this.tenantRow_(this.revisions.get(input.quoteRevisionId),context,'Quote revision');if(String(revision.quoteId)!==String(quote.id))throw new VmosValidationError_('Quote revision does not belong to this Quote.');}
  if(input.quoteLineItemId){if(!this.quoteLines)throw new VmosConfigurationError_('Quote line relationships are unavailable.');var quoteLine=this.tenantRow_(this.quoteLines.get(input.quoteLineItemId),context,'Quote line');if(!input.quoteRevisionId||String(quoteLine.quoteRevisionId)!==String(input.quoteRevisionId))throw new VmosValidationError_('Quote line does not belong to the selected revision.');}
  if(type==='PART'&&!input.costLineId&&!input.jobId)throw new VmosValidationError_('Select a related cost line or Work Order for this Part.');var targetId=this.targetId_(input,type);if(!targetId)throw new VmosValidationError_('Select the related record.');return {quote:quote,document:document,type:type,purpose:purpose,visibility:visibility,targetId:targetId};};
QuoteSourceDocumentService_.prototype.searchDocuments=function(query,context,limit){return {items:this.documents.search(context.tenantId,query,Math.min(50,Math.max(1,Number(limit||25)))).map(function(row){return {id:row.id,label:row.title||'Source document',secondary:[row.documentType,row.sourceVersion].filter(Boolean).join(' · '),customerEligible:row.customerEligible===true||String(row.customerEligible).toUpperCase()==='TRUE'};}),bounded:true,limit:Math.min(50,Math.max(1,Number(limit||25)))};};
QuoteSourceDocumentService_.prototype.searchTargets=function(type,query,quoteId,context,limit){type=String(type||'').toUpperCase();var quote=this.tenantRow_(this.quotes.get(quoteId),context,'Quote'),term=String(query||'').trim().toLowerCase(),max=Math.min(50,Math.max(1,Number(limit||25))),rows=[],self=this;if(type==='VENDOR')rows=this.vendors.forTenant(context.tenantId).filter(function(row){return String(row.status||'ACTIVE').toUpperCase()==='ACTIVE';}).map(function(row){return {id:row.id,label:row.name||'Vendor',secondary:row.supplyType||''};});else if(type==='JOB')rows=this.jobs.list().filter(function(row){return String(row.securityTenantId||row.tenantId)===String(context.tenantId)&&String(row.quoteId)===String(quote.id);}).map(function(row){return {id:row.id,label:'Work Order '+row.id,secondary:[row.partId,row.status].filter(Boolean).join(' · ')};});else if(type==='QUOTE_COST_LINE'||type==='PART'){var estimateIds=this.estimates.byField(context.tenantId,'quoteId',quote.id,10).map(function(row){return row.id;}),seen={};estimateIds.forEach(function(estimateId){self.costLines.byField(context.tenantId,'estimateId',estimateId,50).forEach(function(row){var id=type==='PART'?row.partId:row.id;if(id&&!seen[id]){seen[id]=true;rows.push({id:id,label:type==='PART'?'Part '+id:(row.description||'Cost line'),secondary:type==='PART'?(row.description||'Quote cost context'):[row.category,row.vendorId].filter(Boolean).join(' · '),costLineId:row.id});}});});}else throw new VmosValidationError_('Related-record picker type is invalid.');rows=rows.filter(function(row){return !term||String(row.label+' '+row.secondary).toLowerCase().indexOf(term)!==-1;});return {items:rows.slice(0,max),bounded:true,limit:max,hasMore:rows.length>max};};
QuoteSourceDocumentService_.prototype.list=function(quoteId,context,limit){this.tenantRow_(this.quotes.get(quoteId),context,'Quote');var docs={},self=this,rows=this.links.byField(context.tenantId,'quoteId',quoteId,Math.min(100,Math.max(1,Number(limit||50)))).filter(function(row){return String(row.status||'ACTIVE').toUpperCase()==='ACTIVE';});rows.forEach(function(row){if(!docs[row.documentId]){try{docs[row.documentId]=self.tenantRow_(self.documents.get(row.documentId),context,'Source document');}catch(ignored){docs[row.documentId]=null;}}});return rows.map(function(row){var document=docs[row.documentId];return {id:row.id,documentId:row.documentId,title:document&&document.title||'Source document unavailable',documentType:document&&document.documentType||'',relationshipType:row.relationshipType,purpose:row.purpose,visibility:row.visibility,status:document?'ACTIVE':'REFERENCE_UNAVAILABLE',version:Number(row.version||1),targetLabel:self.targetId_(row,row.relationshipType)};});};
QuoteSourceDocumentService_.prototype.add=function(input,context,id){var self=this,valid=this.validate_(input,context);return this.withLock_(function(){var duplicate=self.links.forTenant(context.tenantId).filter(function(row){return String(row.status||'ACTIVE').toUpperCase()==='ACTIVE'&&row.quoteId===valid.quote.id&&row.documentId===valid.document.id&&row.relationshipType===valid.type&&self.targetId_(row,valid.type)===valid.targetId&&row.purpose===valid.purpose;})[0],now=self.clock();if(duplicate){if(String(duplicate.visibility)!==String(valid.visibility))duplicate=self.links.update(duplicate.id,{visibility:valid.visibility,version:Number(duplicate.version||1)+1,updatedAt:now,updatedBy:context.userId,securityOperationId:context.operationId,securityOperationFingerprint:context.requestFingerprint,securityActorId:context.userId});return {link:duplicate,duplicate:true};}var record={id:id,tenantId:context.tenantId,documentId:valid.document.id,relationshipType:valid.type,quoteId:valid.quote.id,quoteRevisionId:input.quoteRevisionId||'',quoteLineItemId:input.quoteLineItemId||'',estimateId:input.estimateId||'',costLineId:input.costLineId||'',rfqId:input.rfqId||'',customerId:input.customerId||'',partId:input.partId||'',vendorId:input.vendorId||'',jobId:input.jobId||'',purpose:valid.purpose,visibility:valid.visibility,sourceFingerprint:valid.document.sourceFingerprint||'',sourceVersion:valid.document.sourceVersion||'',status:'ACTIVE',version:1,createdAt:now,createdBy:context.userId,updatedAt:now,updatedBy:context.userId,removedAt:'',removedBy:'',securityOperationId:context.operationId,securityOperationFingerprint:context.requestFingerprint,securityActorId:context.userId};return {link:self.links.create(record),duplicate:false};});};
QuoteSourceDocumentService_.prototype.remove=function(id,expectedVersion,context){var self=this;return this.withLock_(function(){var row=self.tenantRow_(self.links.get(id),context,'Source document link');if(String(row.status||'ACTIVE').toUpperCase()==='REMOVED')return {link:row,alreadyRemoved:true};if(Number(row.version||1)!==Number(expectedVersion))throw new VmosConflictError('This source relationship changed. Refresh before trying again.');var now=self.clock();return {link:self.links.update(id,{status:'REMOVED',version:Number(row.version||1)+1,updatedAt:now,updatedBy:context.userId,removedAt:now,removedBy:context.userId,securityOperationId:context.operationId,securityOperationFingerprint:context.requestFingerprint,securityActorId:context.userId}),alreadyRemoved:false};});};
