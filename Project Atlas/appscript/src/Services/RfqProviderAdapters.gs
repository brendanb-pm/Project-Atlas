/** Concrete adapters. Construction is inert; configuration is validated before any provider call. */
function getRfqProviderConfig_() { var p=PropertiesService.getScriptProperties(), label=p.getProperty('VMOS_RFQ_GMAIL_LABEL'), root=p.getProperty('VMOS_RFQ_DRIVE_ROOT_ID'), key=p.getProperty('VMOS_OPENAI_API_KEY'); if (!label||!root||!key) throw new VmosConfigurationError_('RFQ Intake requires VMOS_RFQ_GMAIL_LABEL, VMOS_RFQ_DRIVE_ROOT_ID, and VMOS_OPENAI_API_KEY. No provider was called.'); return {label:label,rootId:root,key:key,model:p.getProperty('VMOS_RFQ_OPENAI_MODEL')||'gpt-4.1-mini'}; }
function GmailRfqProvider_(config) { this.config=config||getRfqProviderConfig_(); }
GmailRfqProvider_.prototype.listCandidateMessages=function(){ return GmailApp.search('label:"'+this.config.label.replace(/"/g,'')+'"').reduce(function(all,thread){return all.concat(thread.getMessages().map(function(message){return {messageId:message.getId(),threadId:thread.getId(),senderName:message.getFrom(),senderEmail:message.getFrom(),subject:message.getSubject(),body:message.getPlainBody(),receivedAt:message.getDate(),originalMessageReference:message.getId(),attachments:message.getAttachments({includeInlineImages:false,includeAttachments:true}).map(function(a){return {name:a.getName(),mimeType:a.getContentType(),sizeBytes:a.getBytes().length,blob:a};})};}));},[]); };
function DriveRfqStagingProvider_(config, drive) { this.config=config||getRfqProviderConfig_(); this.drive=drive||DriveApp; }
DriveRfqStagingProvider_.prototype.stage=function(intakeId,attachment){ var bytes=attachment.blob.getBytes(), checksum=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes).map(function(b){return ('0'+(b&255).toString(16)).slice(-2);}).join(''); return {filename:attachment.name,mimeType:attachment.mimeType,sizeBytes:attachment.sizeBytes,sha256:checksum,stagingReference:'RFQ Intake/'+intakeId+'/Attachments/'+attachment.name,status:'STAGED'}; };
function OpenAiRfqProvider_(config, fetcher) { this.config=config||getRfqProviderConfig_(); this.fetcher=fetcher||UrlFetchApp; }
OpenAiRfqProvider_.prototype.extract=function(message){ var payload={model:this.config.model,input:[{role:'system',content:'Extract only explicit RFQ facts. Unknown stays empty. Never infer pricing, delivery, material, revision, tolerance, or entity identity. Return JSON only.'},{role:'user',content:message.body||''}],text:{format:{type:'json_object'}}}; var response=this.fetcher.fetch('https://api.openai.com/v1/responses',{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+this.config.key},payload:JSON.stringify(payload),muteHttpExceptions:true}); if(response.getResponseCode()<200||response.getResponseCode()>299) throw new VmosValidationError_('RFQ extraction provider failed without staging a production record.'); var body=JSON.parse(response.getContentText()); return validateRfqIntakeProposal_(JSON.parse(body.output_text||'{}')); };
