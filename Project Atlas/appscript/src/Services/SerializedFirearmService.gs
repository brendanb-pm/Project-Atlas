SerializedFirearmService_.prototype.searchRelationships=function(type,query,firearmId,c){c=this.assertContext_(c);type=String(type||'').toUpperCase();var term=String(query||'').trim().toUpperCase(),limit=25,selected=firearmId?this.assertTenant_(this.records.get(firearmId),c):null,rows,items,customerNames={};if(type==='CUSTOMER'){rows=this.customers.list();items=rows.filter(function(r){return String(r.tenantId||r.securityTenantId)===String(c.tenantId);}).filter(function(r){return !term||[r.name,r.companyName,r.email,r.phone].join(' ').toUpperCase().indexOf(term)!==-1;}).slice(0,limit).map(function(r){return {id:r.id,label:r.name||r.companyName||'Customer',secondary:[r.email,r.phone].filter(Boolean).join(' · '),state:'AVAILABLE'};});}else if(type==='FFL'){rows=this.ffls.list();items=rows.filter(function(r){return String(r.tenantId)===String(c.tenantId)&&(!r.status||String(r.status).toUpperCase()==='ACTIVE');}).filter(function(r){return !term||[r.displayName,r.licenseReference,r.premisesAddress].join(' ').toUpperCase().indexOf(term)!==-1;}).slice(0,limit).map(function(r){return {id:r.id,label:r.displayName||'External FFL',secondary:[r.licenseReference,r.premisesAddress].filter(Boolean).join(' · '),state:'AVAILABLE'};});}else if(type==='JOB'){this.customers.list().filter(function(r){return String(r.tenantId||r.securityTenantId)===String(c.tenantId);}).forEach(function(r){customerNames[r.id]=r.name||r.companyName||'Customer';});rows=this.jobs.list();items=rows.filter(function(r){return String(r.tenantId||r.securityTenantId)===String(c.tenantId)&&['COMPLETE','COMPLETED','CLOSED','CANCELLED','CANCELED'].indexOf(String(r.status||'').toUpperCase())===-1&&(!selected||!selected.customerId||!r.customerId||String(r.customerId)===String(selected.customerId));}).filter(function(r){return !term||[r.id,r.partId,r.description,r.status,customerNames[r.customerId]].join(' ').toUpperCase().indexOf(term)!==-1;}).slice(0,limit).map(function(r){return {id:r.id,label:[r.id,r.partId||r.descr