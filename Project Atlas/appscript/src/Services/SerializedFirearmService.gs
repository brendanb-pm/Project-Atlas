var ATLAS_FIREARM_SOURCE_TYPES=['CUSTOMER','INVENTORY','FFL'];
var ATLAS_FIREARM_RECIPIENT_TYPES=['CUSTOMER','FFL'];
var ATLAS_FIREARM_CORRECTABLE_FIELDS=['manufacturer','importer','model','serialNumber','caliberGauge','classification','acquisitionDate','acquisitionSourceName','customerId','externalFflId','jobId','custodyLocation'];
function normalizeFirearmSerial_(value){return String(value||'').trim().toUpperCase().replace(/[\s-]+/g,'');}
function SerializedFirearmService_(deps){deps=deps||{};this.records=deps.records||new SerializedFirearmRepository_();this.events=deps.events||new FirearmRegulatoryEventRepository_();this.customers=deps.customers||{get:function(id){return new MvpService_('Customer').get(id);},list:function(){return new MvpService_('Customer').list();}};this.jobs=deps.jobs||{get:function(id){return new MvpService_('Job').get(id);},list:function(){return new MvpService_('Job').list();}};this.ffls=deps.ffls||new ExternalFflRepository_();this.clock=deps.clock||function(){return new Date();};this.uuid=deps.uuid||function(){return Utilities.getUuid().replace(/-/g,'').toUpperCase();};}
SerializedFirearmService_.prototype.assertContext_=function(c){if(!c||!c.tenantId||!c.userId)throw new VmosAuthorizationError_();return c;};
SerializedFirearmService_.prototype.assertTenant_=function(r,c){if(!r||String(r.tenantId)!==String(c.tenantId))throw new VmosNotFoundError_('Serialized item was not found.');return r;};
SerializedFirearmService_.prototype.validateRelationships_=function(input,c){var self=this;[['customerId',this.customers],['jobId',this.jobs],['externalFflId',this.ffls]].forEach(function(pair){var id=input[pair[0]],repo=pair[1];if(!id)return;if(!repo)throw new VmosConfigurationError_('Relationship validation is unavailable.');var related=repo.get?repo.get(id):repo.findById(id);if(!related||related.tenantId&&String(related.tenantId)!==String(c.tenantId))throw new VmosNotFoundError_('Related record was not found.');});};
SerializedFirearmService_.prototype.eventId_=function(c,type){return 'FAE-'+String(c.operationId||c.correlationId||this.uuid()).replace(/[^A-Za-z0-9]/g,'').slice(-28)+'-'+String(type).slice(0,12);};
SerializedFirearmService_.prototype.pending_=function(record,type,details,previous,c,reason,correctionOf){var event={id:this.eventId_(c,type),tenantId:c.tenantId,firearmId:record.id,eventType:type,occurredAt:this.clock(),actorUserId:c.userId,correlationId:c.correlationId||c.operationId||'',previousJson:JSON.stringify(previous||{}),detailsJson:JSON.stringify(details||{}),correctionOfEventId:correctionOf||'',reason:reason||'',recoveryActorUserId:'',recoveredAt:''};return {event:event,fields:{pendingEventId:event.id,pendingEventType:type,pendingEventJson:JSON.stringify(event),reconciliationStatus:'EVENT_PENDING'}};};
SerializedFirearmService_.prototype.appendAndClear_=function(id,pending){try{this.events.append(pending.event);return this.records.update(id,{pendingEventId:'',pendingEventType:'',pendingEventJson:'',reconciliationStatus:'CURRENT'});}catch(error){throw error;}};
SerializedFirearmService_.prototype.intake=function(input,c,resourceId){c=this.assertContext_(c);input=input||{};['manufacturer','model','serialNumber','caliberGauge','classification','acquisitionDate','acquisitionSourceType','acquisitionSourceName','custodyLocation'].forEach(function(k){if(!String(input[k]||'').trim())throw new VmosValidationError_(k+' is required.');});var source=String(input.acquisitionSourceType).toUpperCase();if(ATLAS_FIREARM_SOURCE_TYPES.indexOf(source)===-1)throw new VmosValidationError_('Choose Customer, Inventory, or FFL as the acquisition source.');if(source==='CUSTOMER'&&!input.customerId)throw new VmosValidationError_('Choose the source Customer.');if(source==='FFL'&&!input.externalFflId)throw new VmosValidationError_('Choose the source FFL.');this.validateRelationships_(input,c);var serial=normalizeFirearmSerial_(input.serialNumber);if(!serial)throw new VmosValidationError_('Serial number is required.');var duplicate=this.records.findDuplicate(c.tenantId,input.manufacturer,input.importer||'',serial);if(duplicate)throw new VmosConflictError('A matching manufacturer/importer and serial number already exists. Open the existing serialized record or reconcile the conflict.');var now=this.clock(),record={id:resourceId||('FIREARM-'+this.uuid()),tenantId:c.tenantId,manufacturer:String(input.manufacturer).trim(),importer:String(input.importer||'').trim(),model:String(input.model).trim(),serialNumber:String(input.serialNumber).trim(),serialNormalized:serial,caliberGauge:String(input.caliberGauge).trim(),classification:String(input.classification).trim(),acquisitionDate:input.acquisitionDate,acquisitionSourceType:source,acquisitionSourceId:input.acquisitionSourceId||input.customerId||input.externalFflId||'',acquisitionSourceName:String(input.acquisitionSourceName).trim(),dispositionDate:'',recipientType:'',recipientId:'',recipientName:'',customerId:input.customerId||'',externalFflId:input.externalFflId||'',jobId:input.jobId||'',custodyLocation:String(input.custodyLocation).trim(),custodyStatus:'IN_SHOP',lifecycleStatus:'ACQUIRED',version:1,createdAt:now,createdBy:c.userId,updatedAt:now,updatedBy:c.userId,securityOperationId:c.operationId||'',securityOperationFingerprint:c.requestFingerprint||c.operationFingerprint||''};var pending=this.pending_(record,'ACQUIRED',{sourceType:source,sourceId:record.acquisitionSourceId,sourceName:record.acquisitionSourceName,custodyLocation:record.custodyLocation},null,c);Object.keys(pending.fields).forEach(function(k){record[k]=pending.fields[k];});this.records.create(record);return this.appendAndClear_(record.id,pending);};
SerializedFirearmService_.prototype.get=function(id,c){var r=this.assertTenant_(this.records.get(id),this.assertContext_(c));r.history=this.events.listByFirearm(c.tenantId,id).sort(function(a,b){return String(b.occurredAt).localeCompare(String(a.occurredAt));}).slice(0,100);return r;};
SerializedFirearmService_.prototype.list=function(request,c){c=this.assertContext_(c);request=request||{};var q=String(request.query||'').toUpperCase(),rows=this.records.list().filter(function(r){return String(r.tenantId)===String(c.tenantId);}).filter(function(r){return !q||[r.id,r.manufacturer,r.importer,r.model,r.serialNumber,r.caliberGauge,r.customerId,r.jobId,r.custodyLocation].join(' ').toUpperCase().indexOf(q)!==-1;}).slice(0,100);return rows;};
SerializedFirearmService_.prototype.workspace=function(request,c){var rows=this.list(request,c),selected=request&&request.id?this.get(request.id,c):null,bySerial={},tenant=c.tenantId;rows.forEach(function(r){(bySerial[r.serialNormalized]=bySerial[r.serialNormalized]||[]).push(r);});function directory(repo,label){if(!repo||!repo.list)return [];return repo.list().filter(function(r){return !r.tenantId||String(r.tenantId)===String(tenant);}).slice(0,100).map(function(r){return {id:r.id,label:r[label]||r.displayName||r.name||r.id};});}var jobDirectory=directory(this.jobs,'id');if(this.jobs&&this.jobs.list)jobDirectory=this.jobs.list().filter(function(r){return !r.tenantId||String(r.tenantId)===String(tenant);}).slice(0,100).map(function(r){return {id:r.id,label:[r.id,r.partId,r.status].filter(Boolean).join(' — ')};});return {items:rows,selected:selected,customers:directory(this.customers,'name'),jobs:jobDirectory,ffls:directory(this.ffls,'displayName'),reconciliation:rows.filter(function(r){return r.reconciliationStatus&&r.reconciliationStatus!=='CURRENT'||(bySerial[r.serialNormalized]||[]).length>1;}),bounds:{items:100,history:100,directories:100},legalNotice:'LEGAL/COMPLIANCE REVIEW REQUIRED: Atlas supports internal records and inspection exports; legal sufficiency requires qualified review.'};};
SerializedFirearmService_.prototype.mutate_=function(id,changes,type,details,c,expectedVersion,reason,correctionOf){c=this.assertContext_(c);var current=this.assertTenant_(this.records.get(id),c);if(current.pendingEventId)throw new VmosConflictError('This serialized record requires reconciliation before another change.');if(Number(current.version)!==Number(expectedVersion))throw new VmosConflictError('Serialized record changed. Refresh before continuing.');var previous={},nextVersion=Number(current.version)+1;Object.keys(changes).forEach(function(k){previous[k]=current[k];});var pending=this.pending_(current,type,details||changes,previous,c,reason,correctionOf);changes.version=nextVersion;changes.updatedAt=this.clock();changes.updatedBy=c.userId;Object.keys(pending.fields).forEach(function(k){changes[k]=pending.fields[k];});this.records.update(id,changes);return this.appendAndClear_(id,pending);};
SerializedFirearmService_.prototype.assignJob=function(id,jobId,expectedVersion,c){this.validateRelationships_({jobId:jobId},c);return this.mutate_(id,{jobId:jobId},'JOB_ASSIGNED',{jobId:jobId},c,expectedVersion);};
SerializedFirearmService_.prototype.moveCustody=function(id,location,status,expectedVersion,c){if(!String(location||'').trim())throw new VmosValidationError_('Custody location is required.');return this.mutate_(id,{custodyLocation:String(location).trim(),custodyStatus:String(status||'IN_SHOP').toUpperCase()},'CUSTODY_MOVED',{location:location,status:status},c,expectedVersion);};
SerializedFirearmService_.prototype.dispose=function(id,input,expectedVersion,c){input=input||{};var recipient=String(input.recipientType||'').toUpperCase();if(ATLAS_FIREARM_RECIPIENT_TYPES.indexOf(recipient)===-1||!input.dispositionDate||!String(input.recipientName||'').trim())throw new VmosValidationError_('Disposition date, recipient type, and recipient name are required.');if(recipient==='CUSTOMER'&&!input.customerId)throw new VmosValidationError_('Choose the recipient Customer.');if(recipient==='FFL'&&!input.externalFflId)throw new VmosValidationError_('Choose the recipient FFL.');this.validateRelationships_({customerId:input.customerId,externalFflId:input.externalFflId},c);return this.mutate_(id,{dispositionDate:input.dispositionDate,recipientType:recipient,recipientId:input.customerId||input.externalFflId||'',recipientName:String(input.recipientName).trim(),custodyStatus:'RELEASED',lifecycleStatus:'DISPOSED'},'DISPOSED',{recipientType:recipient,recipientId:input.customerId||input.externalFflId||'',recipientName:input.recipientName,dispositionDate:input.dispositionDate},c,expectedVersion);};
SerializedFirearmService_.prototype.correct=function(id,changes,reason,correctionOf,expectedVersion,c){if(!String(reason||'').trim())throw new VmosValidationError_('Correction reason is required.');var safe={};Object.keys(changes||{}).forEach(function(k){if(ATLAS_FIREARM_CORRECTABLE_FIELDS.indexOf(k)===-1)throw new VmosValidationError_('That field cannot be corrected through this workflow.');safe[k]=changes[k];});if(!Object.keys(safe).length)throw new VmosValidationError_('Select at least one correction.');if(safe.serialNumber)safe.serialNormalized=normalizeFirearmSerial_(safe.serialNumber);this.validateRelationships_(safe,c);return this.mutate_(id,safe,'CORRECTED',{changes:safe},c,expectedVersion,reason,correctionOf);};
SerializedFirearmService_.prototype.reconcile=function(id,c){c=this.assertContext_(c);var r=this.assertTenant_(this.records.get(id),c);if(!r.pendingEventId)return {status:'CURRENT',record:r};var event;try{event=JSON.parse(r.pendingEventJson||'');}catch(e){throw new VmosConflictError('Stored recovery context is unreadable. Qualified review is required.');}if(!event.id||event.id!==r.pendingEventId||event.firearmId!==r.id||event.tenantId!==r.tenantId)throw new VmosAuthorizationError_();try{this.events.get(event.id);}catch(error){if(!error||error.code!=='NOT_FOUND')throw error;event.recoveryActorUserId=c.userId;event.recoveredAt=this.clock();this.events.append(event);}var updated=this.records.update(id,{pendingEventId:'',pendingEventType:'',pendingEventJson:'',reconciliationStatus:'CURRENT',updatedAt:this.clock(),updatedBy:c.userId});return {status:'RECOVERED',record:updated,eventId:event.id,originalActor:event.actorUserId,recoveryActor:c.userId};};
SerializedFirearmService_.prototype.exportCsv=function(request,c){var rows=this.list(request,c),fields=['id','manufacturer','importer','model','serialNumber','caliberGauge','classification','acquisitionDate','acquisitionSourceName','dispositionDate','recipientName','customerId','externalFflId','jobId','custodyLocation','custodyStatus','lifecycleStatus'];function cell(v){return '"'+String(v==null?'':v).replace(/"/g,'""')+'"';}return [fields.join(',')].concat(rows.map(function(r){return fields.map(function(f){return cell(r[f]);}).join(',');})).join('\n');};
