SerializedFirearmService_.prototype.reference_=function(repo,id,c,type){if(!id)return {id:'',label:type==='JOB'?'Not assigned':'Not linked',state:'NONE'};try{var row=this.related_(repo,id,c),label=type==='CUSTOMER'?(row.name||row.companyName||'Customer'):type==='FFL'?(row.displayName||'External FFL'):[row.id,row.partId||row.description,row.status].filter(Boolean).join(' — '),secondary;if(type==='FFL')secondary=[row.licenseReference,row.premisesAddress].filter(Boolean).join(' · ');else if(type==='CUSTOMER')secondary=[row.email,row.phone].filter(Boolean).join(' · ');else if(row.customerId){try{var customer=this.related_(this.customers,row.customerId,c);secondary=customer.name||customer.companyName||'Linked Customer';}catch(ignored){secondary='Linked Customer unavailable';}}return {id:id,label:label,secondary:secondary||'',state:row.status&&String(row.status).toUpperCase()!=='ACTIVE'&&type==='FFL'?'UNAVAILABLE':'AVAILABLE'};}catch(error){return {id:id,label:'Referenced '+(type==='FFL'?'FFL':type==='JOB'?'Job / Work Order':'Customer')+' unavailable',secondary:'Stored relationship retained',state:'UNAVAILABLE'};}};
