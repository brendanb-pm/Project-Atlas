SerializedFirearmService_.prototype.mutate_=function(id,changes,type,details,c,expectedVersion,reason,correctionOf){c=this.assertContext_(c);var current=this.assertTenant_(this.records.get(id),c);if(current.pendingEventId)throw new VmosConflictError('This serialized record requires reconciliation before another change.');if(Number(current.version)!==Number(expectedVersion))throw new VmosConflictError('Serialized record changed. Refresh before continuing.');var previous={},nextVersion=Number(current.version)+1;Object.keys(changes).forEach(function(k){previous[k]=current[k];});var pending=this.pending_(current,type,details||changes,previous,c,reason,correctionOf);changes.version=nextVersion;changes.updatedAt=this.clock();changes.updatedBy=c.userId;Object.keys(pending.fields).forEach(function(k){changes[k]=pending.fields[k];});this.records.update(id,changes);return this.appendAndClear_(id,pending);};
SerializedFirearmService_.prototype.assignJob=function(id,jobId,expectedVersion,c){var current=this.assertTenant_(this.records.get(id),this.assertContext_(c)),job=this.related_(this.jobs,jobId,c);if(current.customerId&&job.customerId&&String(current.customerId)!==String(job.customerId))throw new VmosValidationError_('Choose a Job / Work Order for the linked Customer.');if(['COMPLETE','COMPLETED','CLOSED','CANCELLED','CANCELED'].indexOf(String(job.status||'').toUpperCase())!==-1)throw new VmosValidationError_('Choose an active Job / Work Order.');return this.mutate_(id,{jobId:jobId},'JOB_ASSIGNED',{jobId:jobId},c,expectedVersion);};
SerializedFirearmService_.prototype.moveCustody=function(id,location,status,expectedVersion,c){var allowed=['IN_SHOP','IN_WORK'],next=String(status||'').toUpperCase();if(!String(location||'').trim())throw new VmosValidationError_('Custody location is required.');if(allowed.indexOf(next)===-1)throw new VmosValidationError_('Choose an available custody state.');return this.mutate_(id,{custodyLocation:String(location).trim(),custodyStatus:next},'CUSTODY_MOVED',{location:location,status:next},c,expectedVersion);};
SerializedFirearmService_.prototype.dispose=function(id,input,expectedVersion,c){input=input||{};var recipient=String(input.recipientType||'').toUpperCase(),related,name;if(ATLAS_FIREARM_RECIPIENT_TYPES.indexOf(recipient)===-1||!input.dispositionDate)throw new VmosValidationError_('Disposition date and recipient type are required.');if(recipient==='CUSTOMER'&&!input.customerId)throw new VmosValidationError_('Choose the recipient Customer.');if(recipient==='FFL'&&!input.externalFflId)throw new VmosValidationError_('Choose the recipient FFL.');this.validateRelationships_({customerId:input.customerId,externalFflId:input.externalFflId},c);related=recipient==='CUSTOMER'?this.related_(this.customers,input.customerId,c):this.related_(this.ffls,input.externalFflId,c);name=recipient==='CUSTOMER'?(related.name||related.companyName||'Customer'):(related.displayName||'External FFL');return this.mutate_(id,{dispositionDate:input.dispositionDate,recipientType:recipient,recipientId:input.customerId||input.externalFflId||'',recipientName:name,custodyStatus:'RELEASED',lifecycleStatus:'DISPOSED'},'DISPOSED',{recipientType:recipient,recipientId:input.customerId||input.externalFflId||'',recipientName:name,dispositionDate:input.dispositionDate},c,expectedVersion);};
SerializedFirearmService_.prototype.correct=function(id,changes,reason,correctionOf,expectedVersion,c){if(!String(reason||'').trim())throw new VmosValidationError_('Correction reason is required.');var safe={};Object.keys(changes||{}).forEach(function(k){if(ATLAS_FIREARM_CORRECTABLE_FIELDS.indexOf(k)===-1)throw new VmosValidationError_('That field cannot be corrected through this workflow.');safe[k]=changes[k];});if(!Object.keys(safe).length)throw new VmosValidationError_('Select at least one correction.');if(safe.serialNumber)safe.serialNormalized=normalizeFirearmSerial_(safe.serialNumber);this.validateRelationships_(safe,c);return this.mutate_(id,safe,'CORRECTED',{changes:safe},c,expectedVersion,reason,correctionOf);};
