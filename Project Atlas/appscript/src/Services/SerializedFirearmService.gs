SerializedFirearmService_.prototype.get=function(id,c){var r=this.assertTenant_(this.records.get(id),this.assertContext_(c));r.history=this.events.listByFirearm(c.tenantId,id).sort(function(a,b){return String(b.occurredAt).localeCompare(String(a.occurredAt));}).slice(0,100);return r;};
