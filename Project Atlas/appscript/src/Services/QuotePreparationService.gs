/** Human-priced quote drafts/revisions; no Job is created here. */
function QuotePreparationService(deps){deps=deps||{};this.rfqs=deps.rfqs;this.quotes=deps.quotes;this.history=deps.history||[];this.documents=deps.documents||{prepare:function(m){return {status:'PREPARED',model:m};}};this.email=deps.email||{prepare:function(m){return {status:'PREPARED',model:m};}};}
QuotePreparationService.prototype.prepare=function(input){if(!input||!input.rfqId||!input.quantity)throw new VmosValidationError('Approved RFQ and quantity are required.');if(!this.rfqs.get(input.rfqId))throw new VmosNotFoundError('RFQ not found.');var line={description:input.description||'',quantity:Number(input.quantity),unitPrice:Number(input.unitPrice||0),nre:Number(input.nre||0)};if(line.quantity<=0||line.unitPrice<0||line.nre<0)throw new VmosValidationError('Quantity and pricing values are invalid.');var same=this.history.filter(function(q){return q.rfqId===input.rfqId&&String(q.lines[0].quantity)===String(line.quantity);});var revision=same.length?Math.max.apply(null,same.map(function(q){return Number(q.revision||0);}))+1:0;var subtotal=line.quantity*line.unitPrice+line.nre,total=subtotal+Number(input.tax||0)+Number(input.shipping||0);return {status:'DRAFT',rfqId:input.rfqId,revision:revision,lines:[line],subtotal:subtotal,tax:Number(input.tax||0),shipping:Number(input.shipping||0),total:total,paymentTerms:input.paymentTerms||'',validity:input.validity||'',deliveryCommitment:input.deliveryCommitment||'',assumptions:input.assumptions||'',exclusions:input.exclusions||'',customerSuppliedComponents:input.customerSuppliedComponents||[],drawingRevisions:input.drawingRevisions||[]};};
QuotePreparationService.prototype.issue=function(draft){if(draft.status==='ISSUED')return draft;if(!draft||draft.status!=='DRAFT')throw new VmosValidationError('Only a human-reviewed draft can be issued.');var created=this.quotes.create({rfqId:draft.rfqId,customerId:draft.customerId||'',total:draft.total,notes:'Quote revision '+draft.revision});draft.quoteId=created.id;draft.status='ISSUED';this.history.push(draft);try{draft.document=this.documents.prepare(draft);draft.email=this.email.prepare(draft);}catch(error){draft.status='ISSUED_DOCUMENT_PENDING';draft.deliveryError=error.message;}return draft;};
