MicrosoftGraphCalendarFollowUpService_.prototype.handleChangeNotification=function(connectionId,externalEventId,correlationId){var connection=this.connections.get(connectionId),link=this.links.findByExternalEvent('MICROSOFT_GRAPH_CALENDAR',externalEventId);if(!connection||connection.connectionStatus!=='CONNECTED')return {result:'NOT_CONNECTED'};try{var started=this.timer(),event=this.provider.fetchEvent(connection,externalEventId),duration=this.timer()-started;return this.sync.syncFromExternal({provider:'MICROSOFT_GRAPH_CALENDAR',externalEventId:externalEventId,externalVersion:event&&event.changeKey||'',changeType:!event||event.deleted?'DELETED':'UPSERT',startAt:event&&event.startAt||'',endAt:event&&event.endAt||'',timeZone:event&&event.timeZone||'',actor:event&&event.actor||'',mosVersion:link&&link.lastSyncedFollowUpVersion,correlationId:correlationId,providerCorrelationId:event&&event.extensions&&event.extensions.mosCorrelationId||'',providerDurationMs:duration});}catch(error){this.connections.update(connectionId,{lastError:error.message,lastSyncAt:this.clock()});return {result:'FAILED',error:error.message};}};
