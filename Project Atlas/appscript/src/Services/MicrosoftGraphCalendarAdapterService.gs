function MicrosoftGraphCalendarFollowUpService_(deps){this.deps=deps||{};this.followUps=this.deps.followUps;this.links=this.deps.links;this.connections=this.deps.connections;this.routing=this.deps.routing;this.sync=this.deps.sync;this.provider=this.deps.provider;this.clock=this.deps.clock||function(){return new Date();};this.timer=this.deps.timer||function(){return new Date().getTime();};}
