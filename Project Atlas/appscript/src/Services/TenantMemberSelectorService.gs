function TenantMemberSelectorService_(dependencies){dependencies=dependencies||{};this.users=dependencies.users||new AtlasUserRepository_();this.memberships=dependencies.memberships||new TenantMembershipRepository_();}
TenantMemberSelectorService_.prototype.search=function(query,context,limit){var term=String(query||'').trim().toUpperCase(),maximum=Math.min(25,Math.max(1,Number(limit)||15)),active={};this.memberships.list().filter(function(row){return String(row.tenantId)===String(context.tenantId)&&String(row.status).toUpperCase()==='ACTIVE';}).forEach(function(row){active[row.userId]=parseIdentityList_(row.roles);});var items=this.users.list().filter(function(row){return active[row.id]&&String(row.status||'ACTIVE').toUpperCase()==='ACTIVE'&&(!term||[row.displayName,row.id,(active[row.id]||[]).join(' ')].join(' ').toUpperCase().indexOf(term)!==-1);}).slice(0,maximum).map(function(row){return {id:row.id,label:row.displayName||'Atlas user',secondary:(active[row.id]||[]).join(', ')||'Active tenant member'};});return {items:items,limit:maximum};};
