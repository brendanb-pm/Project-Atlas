/** Purpose-built bounded CRM read models; canonical activity mutations remain in SalesActivityService_. */
function SalesWorkspaceService_(dependencies){dependencies=dependencies||{};this.customers=dependencies.customers||new MvpService_('Customer');this.activities=dependencies.activities||createSalesActivityService_();this.directoryLimit=Math.min(200,Math.max(1,Number(dependencies.directoryLimit||100)));this.timelineLimit=Math.min(100,Math.max(1,Number(dependencies.timelineLimit||50)));this.clock=dependencies.clock||function(){return new Date();};}
SalesWorkspaceService_.prototype.directory=function(query){var term=String(query||'').trim().toLowerCase(),rows=this.customers.list().filter(function(row){return !term||[row.name,row.companyName,row.id].some(function(value){return String(value||'').toLowerCase().indexOf(term)!==-1;});}).sort(function(a,b){return String(a.name||a.companyName||a.id).localeCompare(String(b.name||b.companyName||b.id));});var total=rows.length;return {items:rows.slice(0,this.directoryLimit).map(function(row){return {id:row.id,name:row.name||row.companyName||row.id,ownerUserId:row.ownerUserId||row.owner||'',status:row.status||''};}),resultCount:Math.min(total,this.directoryLimit),totalMatching:total,truncated:total>this.directoryLimit};};
SalesWorkspaceService_.prototype.customer=function(customerId){var customer=this.customers.get(customerId);if(!customer)throw new VmosNotFoundError_('Customer not found.');var timeline=this.activities.listTimeline(customerId,this.clock(),this.timelineLimit),health=this.activities.accountFollowUpHealth(customerId,this.clock()),next=timeline.filter(function(item){return item.status!=='CLOSED_WON'&&item.status!=='CLOSED_LOST'&&item.nextAction;}).sort(function(a,b){return new Date(a.nextActionDueAt)-new Date(b.nextActionDueAt);})[0]||null;return serializeVmosValue_({customer:{id:customer.id,name:customer.name||customer.companyName||customer.id,ownerUserId:customer.ownerUserId||customer.owner||'',status:customer.status||''},health:health,nextAction:next?{activityId:next.id,action:next.nextAction,dueAt:next.nextActionDueAt,ownerUserId:next.followUpOwnerUserId||next.ownerUserId,status:next.status}:null,timeline:timeline,resultCount:timeline.length,timelineLimit:this.timelineLimit});};
