CommercialWorkflowService_.prototype.acceptQuote=function(quoteId,context){var quote=this.assertTenant_(this.quotes.get(quoteId),context);if(quote.status==='Accepted')return quote;if(quote.status!=='Issued')throw new VmosConflictError('Only an issued Quote can be marked accepted.');return new MvpService_('Quote',{auditUser:function(){return context.userId;},repository:this.quotes.repository||this.quotes}).update(quote.id,{status:'Accepted'});};
