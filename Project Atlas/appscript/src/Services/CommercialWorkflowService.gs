function CommercialWorkflowService_(dependencies){dependencies=dependencies||{};this.customers=dependencies.customers||new MvpService_('Customer');this.rfqs=dependencies.rfqs||new MvpService_('RFQ');this.quotes=dependencies.quotes||new MvpService_('Quote');this.jobs=dependencies.jobs||new MvpService_('Job');this.invoices=dependencies.invoices||new MvpService_('Invoice');this.limit=Math.min(100,Math.max(1,Number(dependencies.limit||50)));}
CommercialWorkflowService_.prototype.assertTenant_=function(record,context){if(!record)throw new VmosNotFoundError_('Record was not found.');if(record.securityTenantId&&String(record.securityTenantId)!==String(context.tenantId))throw new VmosAuthorizationError_('Record is unavailable.');return record;};
CommercialWorkflowService_.prototype.capabilities_=function(context){var caps=context.capabilities||[];return {createCustomer:caps.indexOf('CORE_RECORD_WRITE')!==-1,createRfq:caps.indexOf('RFQ_WRITE')!==-1,writeQuote:caps.indexOf('QUOTE_WRITE')!==-1,approveQuote:caps.indexOf('QUOTE_APPROVE')!==-1,issueQuote:caps.indexOf('QUOTE_ISSUE')!==-1,createJob:caps.indexOf('OPERATIONS_WRITE')!==-1,createInvoice:caps.indexOf('FINANCE_WRITE')!==-1,logActivity:caps.indexOf('SALES_WRITE')!==-1,createFollowUp:caps.indexOf('FOLLOWUP_WRITE')!==-1};};
CommercialWorkflowService_.prototype.project_=function(entity,row){if(!row)return null;var fields={Customer:['id','name','status','ownerUserId','phone','email','website'],RFQ:['id','customerId','customerRfqNumber','description','status','receivedDate','dueDate','priority'],Quote:['id','rfqId','customerId','status','total','leadTime','paymentTerms'],Job:['id','quoteId','customerId','status','partId','revision','quantity','dueDate','poNumber'],Invoice:['id','jobId','customerId','status','invoiceDate','dueDate','poNumber','total','paymentTerms']}[entity]||['id','status'],view={};fields.forEach(function(key){if(row[key]!==undefined)view[key]=row[key];});return view;};
CommercialWorkflowService_.prototype.directory_=function(entity,service,query){var term=String(query||'').trim().toLowerCase(),rows=service.list().filter(function(row){return !term||Object.keys(row).some(function(key){return ['id','name','description','status','customerRfqNumber','partId'].indexOf(key)!==-1&&String(row[key]||'').toLowerCase().indexOf(term)!==-1;});});var total=rows.length,that=this;return {items:rows.slice(0,this.limit).map(function(row){return that.project_(entity,row);}),totalMatching:total,truncated:total>this.limit};};
CommercialWorkflowService_.prototype.get=function(request,context){request=request||{};var entity={customers:'Customer',rfqs:'RFQ',quotes:'Quote',jobs:'Job',invoices:'Invoice'}[request.route]||'Customer',service={Customer:this.customers,RFQ:this.rfqs,Quote:this.quotes,Job:this.jobs,Invoice:this.invoices}[entity],directory=this.directory_(entity,service,request.query),selected=request.id?this.assertTenant_(service.get(request.id),context):null,related={},customer=null,rfq=null,quote=null,job=null;if(selected){if(entity==='Customer')customer=selected;if(entity==='RFQ'){rfq=selected;customer=this.assertTenant_(this.customers.get(rfq.customerId),context);}if(entity==='Quote'){quote=selected;rfq=this.assertTenant_(this.rfqs.get(quote.rfqId),context);customer=this.assertTenant_(this.customers.get(quote.customerId),context);}if(entity==='Job'){job=selected;quote=this.assertTenant_(this.quotes.get(job.quoteId),context);rfq=this.assertTenant_(this.rfqs.get(quote.rfqId),context);customer=this.assertTenant_(this.customers.get(job.customerId),context);}if(entity==='Invoice'){job=this.assertTenant_(this.jobs.get(selected.jobId),context);quote=this.assertTenant_(this.quotes.get(job.quoteId),context);rfq=this.assertTenant_(this.rfqs.get(quote.rfqId),context);customer=this.assertTenant_(this.customers.get(selected.customerId),context);}if(customer){related.rfqs=this.rfqs.listByField('customerId',customer.id,10);related.quotes=this.quotes.listByField('customerId',customer.id,10);related.jobs=this.jobs.listByField('customerId',customer.id,10);related.invoices=this.invoices.listByField('customerId',customer.id,10);}if(rfq)related.quote=this.quotes.findFirstByField('rfqId',rfq.id)||null;if(quote)related.job=this.jobs.findFirstByField('quoteId',quote.id)||null;if(job)related.invoice=this.invoices.findFirstByField('jobId',job.id)||null;}var that=this;['rfqs','quotes','jobs','invoices'].forEach(function(key){if(related[key])related[key]=related[key].map(function(row){return that.project_({rfqs:'RFQ',quotes:'Quote',jobs:'Job',invoices:'Invoice'}[key],row);});});if(related.quote)related.quote=this.project_('Quote',related.quote);if(related.job)related.job=this.project_('Job',related.job);if(related.invoice)related.invoice=this.project_('Invoice',related.invoice);return serializeVmosValue_({entity:entity,route:request.route||'customers',directory:directory,selected:this.project_(entity,selected),context:{customer:this.project_('Customer',customer),rfq:this.project_('RFQ',rfq),quote:this.project_('Quote',quote),job:this.project_('Job',job)},related:related,actions:this.capabilities_(context),bounds:{directory:this.limit,related:10},repositoryReadModel:'BOUNDED_SERVER_MODEL'});};
CommercialWorkflowService_.prototype.createRfq=function(customerId,input,context,resourceId){var customer=this.assertTenant_(this.customers.get(customerId),context),service=new MvpService_('RFQ',{auditUser:function(){return context.userId;},mutationProof:{operationId:context.operationId,fingerprint:context.requestFingerprint,tenantId:context.tenantId,actorId:context.userId}});input=input||{};return service.create({customerId:customer.id,description:input.description,status:'Received',receivedDate:input.receivedDate||new Date(),dueDate:input.dueDate||'',customerRfqNumber:input.customerRfqNumber||'',priority:input.priority||'',notes:input.notes||''},resourceId);};
