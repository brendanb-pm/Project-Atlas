CommercialWorkflowService_.prototype.createInvoice=function(jobId,input,context,resourceId){var job=this.assertTenant_(this.jobs.get(jobId),context),quote=this.assertTenant_(this.quotes.get(job.quoteId),context),customer=this.assertTenant_(this.customers.get(job.customerId),context),existing=this.invoices.findFirstByField('jobId',job.id);if(existing)return this.assertTenant_(existing,context);input=input||{};var total=input.total;if(total===''||total===undefined||total===null)total=quote.total===''||quote.total===undefined?'':Number(quote.total);var service=new MvpService_('Invoice',{auditUser:function(){return context.userId;},mutationProof:{operationId:context.operationId,fingerprint:context.requestFingerprint,tenantId:context.tenantId,actorId:context.userId}});return service.create({jobId:job.id,customerId:customer.id,status:'Draft',invoiceDate:new Date(),dueDate:input.dueDate||'',poNumber:job.poNumber||'',total:total,paymentTerms:input.paymentTerms||quote.paymentTerms||'',notes:input.notes||''},resourceId);};
