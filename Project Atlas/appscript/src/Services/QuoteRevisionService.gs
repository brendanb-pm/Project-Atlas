/** Durable revision contract; repository is injected until approved mapping/storage is activated. */
var VMOS_QUOTE_REVISION_HEADERS=['QuoteRevisionID','QuoteID','RFQID','Revision','Status','Customer Snapshot','Subtotal','Tax','Shipping','Total','Payment Terms','Validity','Delivery Commitment','Assumptions','Exclusions','Created At','Created By','Issued At','Issued By'];
var VMOS_QUOTE_LINE_ITEM_HEADERS=['QuoteLineItemID','QuoteRevisionID','Line Type','Description','Quantity','Unit Price','Extended Price','Drawing Revision','Customer Supplied Components','Created At'];
function QuoteRevisionService(repo, clock){this.repo=repo;this.clock=clock||function(){return new Date();};}
QuoteRevisionService.prototype.saveDraft=function(model){if(!model||!model.quoteId||!model.rfqId||!model.lines||!model.lines.length)throw new VmosValidationError('Quote, RFQ, and at least one line are required.');var existing=this.repo.listByQuoteId(model.quoteId), last=existing.length?Math.max.apply(null,existing.map(function(r){return Number(r.revision);})): -1;var revision=model.revision===undefined?last+1:Number(model.revision);if(existing.some(function(r){return Number(r.revision)===revision&&r.status==='ISSUED';}))throw new VmosValidationError('Issued quote revisions are immutable; create the next revision.');var totals=quoteRevisionTotals_(model.lines,model.tax,model.shipping);var record={id:model.id||'QREV-'+Utilities.getUuid().toUpperCase(),quoteId:model.quoteId,rfqId:model.rfqId,revision:revision,status:'DRAFT',lines:model.lines,subtotal:totals.subtotal,tax:totals.tax,shipping:totals.shipping,total:totals.total,paymentTerms:model.paymentTerms||'',validity:model.validity||'',deliveryCommitment:model.deliveryCommitment||'',assumptions:model.assumptions||'',exclusions:model.exclusions||'',drawingRevisions:model.drawingRevisions||[],customerSuppliedComponents:model.customerSuppliedComponents||[],createdAt:this.clock()};return this.repo.save(record);};
QuoteRevisionService.prototype.issue=function(id,actor){var r=this.repo.get(id);if(r.status==='ISSUED')return r;if(r.status!=='DRAFT')throw new VmosValidationError('Only a draft can be marked ready to send.');r.status='ISSUED';r.issuedAt=this.clock();r.issuedBy=actor||'';return this.repo.save(r);};
function quoteRevisionTotals_(lines,tax,shipping){var subtotal=lines.reduce(function(sum,line){var quantity=Number(line.quantity),price=Number(line.unitPrice||0);if(quantity<=0||price<0)throw new VmosValidationError('Quote line pricing is invalid.');return sum+quantity*price+(Number(line.nre||0));},0),t=tax===''||tax===undefined?0:Number(tax),s=shipping===''||shipping===undefined?0:Number(shipping);if(t<0||s<0)throw new VmosValidationError('Tax and shipping cannot be negative.');return {subtotal:subtotal,tax:t,shipping:s,total:subtotal+t+s};}
