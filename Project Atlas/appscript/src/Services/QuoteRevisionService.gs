QuoteRevisionService_.prototype.output=function(id,context){var r=this.assertTenant_(this.revisions.get(id),context,'Quote revision');if(['ISSUED','ACCEPTED','SUPERSEDED','EXPIRED','VOIDED'].indexOf(r.status)===-1)throw new VmosConflictError('A customer Quote is available only after issue.');return {quoteNumber:r.quoteNumber,revision:r.revisionNumber,status:r.status,customer:r.customerName,description:r.description,currency:r.currency,issueDate:r.issueDate,validThrough:r.validThrough,paymentTerms:r.paymentTerms,customerNotes:r.customerNotes,recurringTotalMinor:r.recurringTotalMinor,oneTimeTotalMinor:r.oneTimeTotalMinor,totalMinor:r.totalMinor,lines:this.linesFor_(id,context.tenantId).map(function(x){return {description:x.description,quantity:x.quantity,unitPriceMinor:x.unitPriceMinor,extendedPriceMinor:x.extendedPriceMinor,lineType:x.lineType};})};};
