QuoteRevisionService_.prototype.accept=function(id,expectedVersion,context){
  var row=this.assertTenant_(this.revisions.get(id),context,'Quote revision');if(row.status==='ACCEPTED'){this.convergeRoot_(row,context,true);return this.output(id,context);}if(row.status!=='ISSUED'||Number(row.version)!==Number(expectedVersion))throw new VmosConflictError('Only the current issued revision can be accepted. Refresh first.');var newer=this.revisions.byField(context.tenantId,'quoteId',row.quoteId,100).some(function(x){return x.id!==row.id&&(x.status==='ISSUED'||x.status==='ACCEPTED')&&Number(x.revisionNumber)>Number(row.revisionNumber);});if(newer)throw new VmosConflictError('This Quote revision has been superseded.');
