function QuoteRevisionService_(deps){deps=deps||{};this.revisions=deps.revisions||new QuoteRevisionRepository_();this.lines=deps.lines||new QuoteLineItemRepository_();this.quotes=deps.quotes||new MvpService_('Quote');this.customers=deps.customers||new MvpService_('Customer');this.mutationCheckpoints=deps.mutationCheckpoints||(typeof QuoteMutationCheckpointRepository_!=='undefined'?new QuoteMutationCheckpointRepository_():null);this.checkpoint=deps.checkpoint||function(){};this.clock=deps.clock||function(){return new Date();};this.uuid=deps.uuid||function(){return Utilities.getUuid().toUpperCase();};}
QuoteRevisionService_.prototype.persistIntents_=function(rows,context,aggregateId){if(!this.mutationCheckpoints)return;var self=this;rows.forEach(function(row){var id='QMCP-'+context.operationId+'-'+row.id,existing=self.mutationCheckpoints.get(id),record={id:id,tenantId:context.tenantId,operationId:context.operationId,aggregateType:'QUOTE_REVISION_AGGREGATE',aggregateId:aggregateId,resourceType:'QuoteLineItem',resourceId:row.id,payloadJson:JSON.stringify(row),status:'INTENT',createdAt:self.clock(),createdBy:context.userId,completedAt:'',completedBy:''};if(existing){if(String(existing.operationId)!==String(context.operationId)||String(existing.payloadJson)!==record.payloadJson)throw new VmosConflictError('Quote recovery checkpoint conflicts with another operation.');}else self.mutationCheckpoints.create(record);});};
QuoteRevisionService_.prototype.assertTenant_=function(row,context,label){if(!row||String(row.tenantId||row.securityTenantId)!==String(context.tenantId))throw new VmosAuthorizationError_((label||'Quote')+' is unavailable.');return row;};
QuoteRevisionService_.prototype.linesFor_=function(id,tenantId){return this.lines.byField(tenantId,'quoteRevisionId',id,100).filter(function(x){return x.status!=='REPLACED';}).sort(function(a,b){return Number(a.sequence)-Number(b.sequence);});};
