/** Exact-decimal helpers. Money is an integer minor-unit string; operands are normalized decimal strings. */
function atlasDecimal_(value,maxScale,label){var text=String(value===undefined||value===null?'':value).trim();if(!/^\d+(\.\d+)?$/.test(text))throw new VmosValidationError_((label||'Value')+' must be a non-negative decimal.');var parts=text.split('.'),fraction=parts[1]||'';if(fraction.length>maxScale)throw new VmosValidationError_((label||'Value')+' supports at most '+maxScale+' decimal places.');return {units:BigInt(parts[0]+fraction),scale:fraction.length,text:parts[0]+(fraction?'.'+fraction:'')};}
function atlasMinor_(value,label){var text=String(value===undefined||value===null?'':value).trim();if(!/^\d+$/.test(text))throw new VmosValidationError_((label||'Amount')+' must be an exact non-negative minor-unit string.');return text.replace(/^0+(?=\d)/,'');}
function atlasRoundDivide_(numerator,denominator){if(denominator<=0n)throw new VmosValidationError_('Allocation quantity must be greater than zero.');var quotient=numerator/denominator,remainder=numerator%denominator;return quotient+(remainder*2n>=denominator?1n:0n);}
function atlasMultiplyMinorByDecimal_(minor,decimal){var d=atlasDecimal_(decimal,4,'Quantity'),factor=10n**BigInt(d.scale);return String(atlasRoundDivide_(BigInt(atlasMinor_(minor))*d.units,factor));}
function atlasHourlyMinor_(rateMinor,hours,quantity){return atlasMultiplyMinorByDecimal_(atlasMultiplyMinorByDecimal_(rateMinor,hours),quantity);}
function atlasFormatMinor_(minor){var value=String(BigInt(minor||'0')).padStart(3,'0');return value.slice(0,-2)+'.'+value.slice(-2);}

function QuoteCostEngine_(){}
QuoteCostEngine_.prototype.calculateLine=function(input,quoteQuantity){input=input||{};var basis=String(input.basis||''),purpose=String(input.purpose||'INTERNAL_COST_DETAIL'),summary=purpose==='SUPPLIER_SUMMARY'||input.summaryOnly===true,include=summary?false:input.includeInRollup!==false,extended,costEach='';atlasDecimal_(quoteQuantity,4,'Quote quantity');
  if(['INTERNAL_COST_DETAIL','SUPPLIER_SUMMARY','INTERNAL_NOTE'].indexOf(purpose)===-1)throw new VmosValidationError_('Cost-line purpose is invalid.');
  if(purpose==='INTERNAL_NOTE')return Object.assign({},input,{purpose:purpose,summaryOnly:false,includeInRollup:false,extendedCostMinor:'0',costEachMinor:''});
  if(basis==='BATCH_TOTAL'||basis==='ONE_TIME'){extended=atlasMinor_(input.sourceAmountMinor,'Source amount');if(basis==='BATCH_TOTAL')costEach=String(atlasRoundDivide_(BigInt(extended)*10000n,atlasDecimal_(input.allocationQuantity||quoteQuantity,4,'Allocation quantity').units*10n**BigInt(4-atlasDecimal_(input.allocationQuantity||quoteQuantity,4,'Allocation quantity').scale)));}
