function createFollowUpRepository_(entity,mapping){var config=getFollowUpStorageConfig_();return new SheetsRepository_(entity,mapping,SpreadsheetApp.openById(config.spreadsheetId));}
function mappedFollowUpFields_(repository,record){var result={};Object.keys(record).forEach(function(key){if(repository.definition.fields[key])result[key]=record[key];});return result;}
function FollowUpRepository_(){this.repository=createFollowUpRepository_('FollowUp',getFollowUpStorageConfig_().mappings.followUps);}FollowUpRepository_.prototype.create=function(r){return this.repository.insert(mappedFollowUpFields_(this.repository,r));};FollowUpRepository_.prototype.get=function(id){return this.repository.findById(id);};FollowUpRepository_.prototype.list=function(){return this.repository.list();};FollowUpRepository_.prototype.update=function(id,r){return this.repository.updateById(id,mappedFollowUpFields_(this.repository,r));};
function FollowUpEventRepository_(){this.repository=createFollowUpRepository_('FollowUpEvent',getFollowUpStorageConfig_().mappings.events);}FollowUpEventRepository_.prototype.append=function(r){return this.repository.insert(r);};FollowUpEventRepository_.prototype.list=function(){return this.repository.list();};FollowUpEventRepository_.prototype.findByCorrelation=function(followUpId,correlationId){return this.list().filter(function(record){return String(record.followUpId)===String(followUpId)&&String(record.correlationId)===String(correlationId);})[0];};
function CalendarFollowUpLinkRepository_(){this.repository=createFollowUpRepository_('CalendarFollowUpLink',getFollowUpStorageConfig_().mappings.links);}CalendarFollowUpLinkRepository_.prototype.create=function(r){return this.repository.insert(mappedFollowUpFields_(this.repository,r));};CalendarFollowUpLinkRepository_.prototype.get=function(id){return this.repository.findById(id);};CalendarFollowUpLinkRepository_.prototype.list=function(){return this.repository.list();};CalendarFollowUpLinkRepository_.prototype.update=function(id,r){return this.repository.updateById(id,mappedFollowUpFields_(this.repository,r));};CalendarFollowUpLinkRepository_.prototype.findByExternalEvent=function(provider,eventId){return this.repository.list().filter(function(r){return r.provider===provider&&r.externalEventId===eventId;})[0];};CalendarFollowUpLinkRepository_.prototype.findByFollowUpId=function(id){return this.repository.list().filter(function(r){return r.followUpId===id;})[0];};
function ExternalChangeRequestRepository_(){this.repository=createFollowUpRepository_('ExternalChangeRequest',getFollowUpStorageConfig_().mappings.requests);}ExternalChangeRequestRepository_.prototype.create=function(r){return this.repository.insert(mappedFollowUpFields_(this.repository,r));};ExternalChangeRequestRepository_.prototype.get=function(id){return this.repository.findById(id);};ExternalChangeRequestRepository_.prototype.list=function(){return this.repository.list();};ExternalChangeRequestRepository_.prototype.update=function(id,r){return this.repository.updateById(id,mappedFollowUpFields_(this.repository,r));};
function CalendarSyncEventRepository_(repository){if(repository){this.repository=repository;return;}var config=getCalendarSyncEventStorageConfig_();this.repository=new SheetsRepository_('CalendarSyncEvent',config.mapping,SpreadsheetApp.openById(config.spreadsheetId));}CalendarSyncEventRepository_.prototype.append=function(r){return this.repository.insert(mappedFollowUpFields_(this.repository,r));};CalendarSyncEventRepository_.prototype.findByCorrelation=function(provider,correlationId){if(typeof this.repository.findFirstByFields==='function')return this.repository.findFirstByFields({provider:provider,correlationId:correlationId});return this.repository.list().filter(function(r){return r.provider===provider&&r.correlationId===correlationId;})[0];};CalendarSyncEventRepository_.prototype.list=function(){return this.repository.list();};
function UserCalendarConnectionRepository_(){var config=getCalendarConnectionStorageConfig_();this.repository=new SheetsRepository_('UserCalendarConnection',config.mapping,SpreadsheetApp.openById(config.spreadsheetId));}UserCalendarConnectionRepository_.prototype.create=function(r){return this.repository.insert(r);};UserCalendarConnectionRepository_.prototype.get=function(id){return this.repository.findById(id);};UserCalendarConnectionRepository_.prototype.list=function(){return this.repository.list();};UserCalendarConnectionRepository_.prototype.update=function(id,r){return this.repository.updateById(id,r);};UserCalendarConnectionRepository_.prototype.listByUserId=function(userId){return this.repository.list().filter(function(r){return r.userId===userId;});};
