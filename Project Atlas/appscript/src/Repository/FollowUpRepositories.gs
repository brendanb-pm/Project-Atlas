function createFollowUpRepository_(entity,mapping){var config=getFollowUpStorageConfig_();return new SheetsRepository(entity,mapping,SpreadsheetApp.openById(config.spreadsheetId));}
function mappedFollowUpFields_(repository,record){var result={};Object.keys(record).forEach(function(key){if(repository.definition.fields[key])result[key]=record[key];});return result;}
function FollowUpRepository(){this.repository=createFollowUpRepository_('FollowUp',getFollowUpStorageConfig_().mappings.followUps);}FollowUpRepository.prototype.create=function(r){return this.repository.insert(mappedFollowUpFields_(this.repository,r));};FollowUpRepository.prototype.get=function(id){return this.repository.findById(id);};FollowUpRepository.prototype.update=function(id,r){return this.repository.updateById(id,mappedFollowUpFields_(this.repository,r));};
function FollowUpEventRepository(){this.repository=createFollowUpRepository_('FollowUpEvent',getFollowUpStorageConfig_().mappings.events);}FollowUpEventRepository.prototype.append=function(r){return this.repository.insert(r);};
function CalendarFollowUpLinkRepository(){this.repository=createFollowUpRepository_('CalendarFollowUpLink',getFollowUpStorageConfig_().mappings.links);}CalendarFollowUpLinkRepository.prototype.create=function(r){return this.repository.insert(mappedFollowUpFields_(this.repository,r));};CalendarFollowUpLinkRepository.prototype.get=function(id){return this.repository.findById(id);};CalendarFollowUpLinkRepository.prototype.update=function(id,r){return this.repository.updateById(id,mappedFollowUpFields_(this.repository,r));};CalendarFollowUpLinkRepository.prototype.findByExternalEvent=function(provider,eventId){return this.repository.list().filter(function(r){return r.provider===provider&&r.externalEventId===eventId;})[0];};CalendarFollowUpLinkRepository.prototype.findByFollowUpId=function(id){return this.repository.list().filter(function(r){return r.followUpId===id;})[0];};
function ExternalChangeRequestRepository(){this.repository=createFollowUpRepository_('ExternalChangeRequest',getFollowUpStorageConfig_().mappings.requests);}ExternalChangeRequestRepository.prototype.create=function(r){return this.repository.insert(mappedFollowUpFields_(this.repository,r));};ExternalChangeRequestRepository.prototype.get=function(id){return this.repository.findById(id);};ExternalChangeRequestRepository.prototype.update=function(id,r){return this.repository.updateById(id,mappedFollowUpFields_(this.repository,r));};
function UserCalendarConnectionRepository(){var config=getCalendarConnectionStorageConfig_();this.repository=new SheetsRepository('UserCalendarConnection',config.mapping,SpreadsheetApp.openById(config.spreadsheetId));}UserCalendarConnectionRepository.prototype.create=function(r){return this.repository.insert(r);};UserCalendarConnectionRepository.prototype.get=function(id){return this.repository.findById(id);};UserCalendarConnectionRepository.prototype.update=function(id,r){return this.repository.updateById(id,r);};UserCalendarConnectionRepository.prototype.listByUserId=function(userId){return this.repository.list().filter(function(r){return r.userId===userId;});};
