function createFollowUpRepository_(entity,mapping){var config=getFollowUpStorageConfig_();return new SheetsRepository(entity,mapping,SpreadsheetApp.openById(config.spreadsheetId));}
function FollowUpRepository(){this.repository=createFollowUpRepository_('FollowUp',getFollowUpStorageConfig_().mappings.followUps);}FollowUpRepository.prototype.create=function(r){return this.repository.insert(r);};FollowUpRepository.prototype.get=function(id){return this.repository.findById(id);};FollowUpRepository.prototype.update=function(id,r){return this.repository.updateById(id,r);};
function FollowUpEventRepository(){this.repository=createFollowUpRepository_('FollowUpEvent',getFollowUpStorageConfig_().mappings.events);}FollowUpEventRepository.prototype.append=function(r){return this.repository.insert(r);};
function CalendarFollowUpLinkRepository(){this.repository=createFollowUpRepository_('CalendarFollowUpLink',getFollowUpStorageConfig_().mappings.links);}CalendarFollowUpLinkRepository.prototype.create=function(r){return this.repository.insert(r);};CalendarFollowUpLinkRepository.prototype.get=function(id){return this.repository.findById(id);};CalendarFollowUpLinkRepository.prototype.update=function(id,r){return this.repository.updateById(id,r);};CalendarFollowUpLinkRepository.prototype.findByExternalEvent=function(provider,eventId){return this.repository.list().filter(function(r){return r.provider===provider&&r.externalEventId===eventId;})[0];};CalendarFollowUpLinkRepository.prototype.findByFollowUpId=function(id){return this.repository.list().filter(function(r){return r.followUpId===id;})[0];};
function ExternalChangeRequestRepository(){this.repository=createFollowUpRepository_('ExternalChangeRequest',getFollowUpStorageConfig_().mappings.requests);}ExternalChangeRequestRepository.prototype.create=function(r){return this.repository.insert(r);};ExternalChangeRequestRepository.prototype.get=function(id){return this.repository.findById(id);};ExternalChangeRequestRepository.prototype.update=function(id,r){return this.repository.updateById(id,r);};
