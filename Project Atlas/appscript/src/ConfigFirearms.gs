function getFirearmsConfig_(){var base=getVmosConfig_(),raw=PropertiesService.getScriptProperties().getProperty('ATLAS_FIREARMS_MAPPING'),m=raw?JSON.parse(raw):ATLAS_DEFAULT_FIREARMS_MAPPING;['firearms','events','ffls'].forEach(function(k){var x=m[k];if(!x||!x.sheetName||!x.idField||!x.headers||!x.fields||!x.fields.id)throw new VmosConfigurationError_('Firearms '+k+' mapping is incomplete. No worksheet was changed.');});return {spreadsheetId:base.spreadsheetId,mappings:m};}
function initializeFirearmsPersistence_(){var c=getFirearmsConfig_(),ss=SpreadsheetApp.openById(c.spreadsheetId),out=[];Object.keys(c.mappings).forEach(function(k){var m=c.mappings[k],s=ss.getSheetByName(m.sheetName);if(!s){s=ss.insertSheet(m.sheetName);s.getRange(1,1,1,m.headers.length).setValues([m.headers]);out.push({sheetName:m.sheetName,created:true});return;}var h=s.getRange(1,1,1,s.getLastColumn()).getDisplayValues()[0];if(h.length!==m.headers.length||h.some(function(v,i){return v!==m.headers[i];}))throw new VmosConfigurationError_('Firearms sheet has unexpected headers. No existing sheet was changed.');out.push({sheetName:m.sheetName,created:false});});return out;}
