/** Optional calendar configuration; disabled unless explicitly true. */
function getCalendarFollowUpConfig_(){var properties=PropertiesService.getScriptProperties(),enabled=properties.getProperty('VMOS_CALENDAR_FOLLOWUP_ENABLED')==='true';return {enabled:enabled,provider:properties.getProperty('VMOS_CALENDAR_FOLLOWUP_PROVIDER')||'',calendarId:properties.getProperty('VMOS_CALENDAR_FOLLOWUP_CALENDAR_ID')||''};}
function assertCalendarFollowUpEnabled_(){var config=getCalendarFollowUpConfig_();if(!config.enabled)throw new VmosConfigurationError_('Calendar follow-up synchronization is disabled. MOS follow-ups continue without calendar integration.');if(config.provider!=='GOOGLE_CALENDAR')throw new VmosConfigurationError_('Configure a supported calendar provider before enabling synchronization.');if(!config.calendarId)throw new VmosConfigurationError_('VMOS_CALENDAR_FOLLOWUP_CALENDAR_ID is required when calendar synchronization is enabled.');return config;}

