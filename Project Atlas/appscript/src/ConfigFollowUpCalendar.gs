function getFollowUpStorageConfig_(){var base=getVmosConfig_(),raw=PropertiesService.getScriptProperties().getProperty('VMOS_FOLLOW_UP_MAPPING'),mappings=raw?JSON.parse(raw):VMOS_DEFAULT_FOLLOW_UP_MAPPINGS;['followUps','events','links','requests'].forEach(function(key){if(!mappings[key]||!mappings[key].sheetName||!mappings[key].idField)throw new VmosConfigurationError_('VMOS_FOLLOW_UP_MAPPING.'+key+' is incomplete. No worksheet was changed.');});return {spreadsheetId:base.spreadsheetId,mappings:mappings};}
function getCalendarSyncEventStorageConfig_(){var config=getFollowUpStorageConfig_(),mapping=config.mappings.syncEvents;if(!mapping||!mapping.sheetName||!mapping.idField)throw new VmosConfigurationError_('VMOS_FOLLOW_UP_MAPPING.syncEvents is required for writable calendar synchronization. MOS FollowUps remain available. No worksheet was changed.');return {spreadsheetId:config.spreadsheetId,mapping:mapping};}
function getCalendarConnectionStorageConfig_(){var config=getFollowUpStorageConfig_(),mapping=config.mappings.connections;if(!mapping||!mapping.sheetName||!mapping.idField)throw new VmosConfigurationError_('VMOS_FOLLOW_UP_MAPPING.connections is incomplete. No worksheet was changed.');return {spreadsheetId:config.spreadsheetId,mapping:mapping};}
