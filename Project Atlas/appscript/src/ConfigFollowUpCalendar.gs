  requests:{sheetName:'ExternalChangeRequests',idField:'ExternalChangeRequestID',fields:{id:['ExternalChangeRequestID'],provider:['Provider'],followUpId:['FollowUpID'],previousConnectionId:['Previous ConnectionID'],externalEventId:['External Event ID'],changeType:['Change Type'],cleanupOperation:['Cleanup Operation'],requestedDueAt:['Requested Due At'],requestedStartAt:['Requested Start At'],requestedEndAt:['Requested End At'],requestedTimeZone:['Requested Time Zone'],externalVersion:['External Version'],status:['Status'],details:['Details'],attemptCount:['Attempt Count'],lastAttemptAt:['Last Attempt At'],lastError:['Last Error'],detectedAt:['Detected At'],resolvedAt:['Resolved At'],resolvedBy:['Resolved By'],resolution:['Resolution']}},
